@page
@model GlimpsesOfGlory.Web.Pages.Products.IndexModel
@{
    ViewData["Title"] = "Products";
    ViewData["MetaDescription"] = "Browse all products currently available at Glimpses of Glory.";
}

<div class="container mx-auto px-4 py-10 md:py-16">
    <div class="mb-10 text-center">
        <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-gold-dark">Shop</p>
        <h1 class="text-3xl font-bold md:text-4xl">All products</h1>
    </div>

    @if (Model.Products.Count == 0)
    {
        <p class="text-center text-ink-light">No products available right now.</p>
    }
    else
    {
        <div class="grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-4">
            @foreach (var product in Model.Products)
            {
                <partial name="_ProductCard" model="product" />
            }
        </div>
    }
</div>
