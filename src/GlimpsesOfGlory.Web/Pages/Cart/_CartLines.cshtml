@model GlimpsesOfGlory.Web.Dtos.CartLinesView
@using GlimpsesOfGlory.Abstractions.Dtos
@using GlimpsesOfGlory.Abstractions.Constants
@using GlimpsesOfGlory.Web.Helpers
@{
    // A partial never takes a layout; this also keeps it renderable on its own (in tests).
    Layout = null;
    var cart = Model.Cart;
}

<div id="cart-lines">
    @if (Model.Message is not null)
    {
        <p class="text-red-600 mb-4" role="alert">@Model.Message</p>
    }

    @if (Model.RemovedLine is { } removed)
    {
        @* Undo puts the line back with the quantity it had; the button is disabled while that posts
           so a double click can't add it twice. *@
        <div class="flex flex-wrap items-center gap-2 mb-4 rounded-lg bg-cream-dark px-4 py-2" role="status" data-removed-line="@removed.ProductSlug">
            <span>Removed @removed.ProductName</span>
            <span aria-hidden="true">&middot;</span>
            <form hx-post="/cart?handler=UndoRemove" hx-target="#cart-lines" hx-swap="outerHTML" hx-disabled-elt="find button" asp-antiforgery="true">
                <input type="hidden" name="slug" value="@removed.ProductSlug" />
                <input type="hidden" name="quantity" value="@removed.Quantity" />
                <button type="submit" aria-label="Undo removing @removed.ProductName" class="font-semibold text-gold-dark hover:underline px-1 py-2 disabled:opacity-50">Undo</button>
            </form>
        </div>
    }

    @if (cart.Lines.Count == 0)
    {
        <p>Your cart is empty. <a href="/products" class="text-gold-dark hover:underline">Browse products</a>.</p>
    }
    else
    {
        <div class="flex flex-col gap-4">
            @foreach (var line in cart.Lines)
            {
                var lineError = Model.ErrorFor(line.ProductSlug);
                var hasError = lineError is not null;
                <div class="flex flex-wrap items-center gap-4 border-b border-ink/10 pb-4@(hasError ? " border-l-4 border-l-red-600 pl-3" : "")" data-line-error="@(hasError ? "true" : null)">
                    @if (line.ThumbnailFileName is not null)
                    {
                        <img src="/product-photos/@line.ThumbnailFileName" alt="@line.ProductName" class="w-16 h-16 object-cover rounded-lg flex-shrink-0" />
                    }
                    else
                    {
                        <div class="w-16 h-16 bg-cream-dark rounded-lg flex items-center justify-center text-ink-light text-xs flex-shrink-0">No photo</div>
                    }

                    <div class="flex-1 min-w-[8rem]">
                        <p class="font-semibold">@line.ProductName</p>
                        <p class="text-ink-light text-sm">@line.UnitPrice.ToString("C") each</p>
                        @if (PreorderNoteFormatter.Format(line.IsPreorder, line.ExpectedAvailabilityDate) is { } note)
                        {
                            <p class="text-gold-dark text-sm font-medium">@note</p>
                        }
                    </div>

                    @* The −/+ buttons step the input (within its min/max) and fire its change event when the value
                       moves; their ids keep focus on them across the swap. The short delay lets a few quick taps go
                       as one save, and the spinner shows while the line saves. *@
                    <form class="flex items-center gap-1"
                          x-data="{ step(up) { const q = this.$refs.qty, before = q.value; up ? q.stepUp() : q.stepDown(); if (q.value !== before) q.dispatchEvent(new Event('change', { bubbles: true })); } }"
                          hx-post="/cart?handler=UpdateQuantity" hx-target="#cart-lines" hx-swap="outerHTML" hx-trigger="change delay:400ms"
                          hx-indicator="#saving-@line.ProductSlug" asp-antiforgery="true">
                        <input type="hidden" name="slug" value="@line.ProductSlug" />
                        <button type="button" id="qty-down-@line.ProductSlug" aria-label="Decrease quantity of @line.ProductName" data-step="down"
                                x-on:click="step(false)"
                                class="w-11 h-11 rounded-full border border-ink/20 hover:border-gold-dark text-lg leading-none">&minus;</button>
                        <label for="qty-@line.ProductSlug" class="sr-only">Quantity for @line.ProductName</label>
                        <input type="number" id="qty-@line.ProductSlug" name="quantity" value="@line.Quantity" min="1" max="@(line.IsPreorder ? PreorderPolicy.MaxQuantityPerLine : (int?)null)"
                               x-ref="qty"
                               aria-describedby="@(hasError ? $"error-{line.ProductSlug}" : null)" aria-invalid="@(hasError ? "true" : null)"
                               class="w-14 border border-ink/20 rounded px-2 py-3 text-center" />
                        <button type="button" id="qty-up-@line.ProductSlug" aria-label="Increase quantity of @line.ProductName" data-step="up"
                                x-on:click="step(true)"
                                class="w-11 h-11 rounded-full border border-ink/20 hover:border-gold-dark text-lg leading-none">+</button>
                        <svg id="saving-@line.ProductSlug" class="htmx-indicator h-5 w-5 animate-spin text-gold-dark" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 0 1 8-8v4a4 4 0 0 0-4 4H4z"></path>
                        </svg>
                    </form>

                    <p class="w-24 text-right font-medium">@((line.UnitPrice * line.Quantity).ToString("C"))</p>

                    <form hx-post="/cart?handler=Remove" hx-target="#cart-lines" hx-swap="outerHTML" asp-antiforgery="true">
                        <input type="hidden" name="slug" value="@line.ProductSlug" />
                        <button type="submit" class="text-red-700 hover:underline px-2 py-3">Remove</button>
                    </form>

                    @if (lineError is not null)
                    {
                        <p class="w-full text-red-600 text-sm" id="error-@line.ProductSlug">@lineError.Message</p>
                    }
                </div>
            }
        </div>

        <div class="mt-6 flex flex-col items-end gap-1">
            <p class="text-lg font-bold">Subtotal: @cart.Subtotal.ToString("C")</p>
            <p class="text-ink-light text-sm" data-testid="cart-shipping">Shipping: @cart.ShippingCost.ToString("C") &middot; or free local pickup</p>
            <a href="/checkout" class="bg-gold hover:bg-gold-dark transition-colors text-white px-6 py-3 rounded-full font-semibold mt-2">Proceed to checkout</a>
        </div>
    }
</div>
