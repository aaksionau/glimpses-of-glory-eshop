@page "/checkout/review"
@model GlimpsesOfGlory.Web.Pages.Checkout.ReviewModel
@{
    ViewData["Title"] = "Review order";
}

<div class="py-4">
    <h1 class="text-3xl font-bold mb-6 font-display">Checkout</h1>

    <div class="flex flex-col gap-6 lg:grid lg:grid-cols-[22rem_minmax(0,1fr)] lg:grid-rows-[auto_1fr] lg:items-start lg:gap-10">
        @* Steps sit above the main column; the summary spans both rows on the left. *@
        <div class="lg:col-start-2 lg:row-start-1">
            <partial name="_CheckoutSteps" model="2" />
        </div>

        <aside class="lg:col-start-1 lg:row-start-1 lg:row-span-2 lg:sticky lg:top-4">
            <partial name="_CheckoutOrderSummary" model="Model.Summary" />
        </aside>

        <div class="lg:col-start-2 lg:row-start-2">
            <section class="mb-6">
                <div class="flex items-center justify-between">
                    <h2 class="font-semibold text-lg">@(Model.Address.IsPickup ? "Local pickup" : "Shipping to")</h2>
                    <a href="/checkout" class="text-sm text-gold-dark hover:underline">Edit</a>
                </div>
                <p class="text-ink-light mt-1">
                    @Model.Address.FullName<br />
                    @if (!Model.Address.IsPickup)
                    {
                        <text>
                            @Model.Address.AddressLine1<br />
                            @if (!string.IsNullOrWhiteSpace(Model.Address.AddressLine2))
                            {
                                @Model.Address.AddressLine2<br />
                            }
                            @Model.Address.City, @Model.Address.State @Model.Address.PostalCode<br />
                            @Model.Address.Country<br />
                        </text>
                    }
                    @Model.Address.Email
                    @if (!string.IsNullOrWhiteSpace(Model.Address.Phone))
                    {
                        <br />@Model.Address.Phone
                    }
                </p>
            </section>

            <section class="mt-6">
                @if (Model.Address.IsPickup)
                {
                    @* Cash is only offered for local pickup - it's paid in person when collecting. Card continues
                       to the Payment step; cash places the order straight away. The button is disabled once
                       submitted so a double click can't place the order twice, and re-enabled if the shopper
                       comes back to this page from the browser's history. *@
                    <form method="post" asp-page-handler="PickupPayment"
                          x-data="{ submitting: false }"
                          x-on:submit="submitting = true"
                          x-on:pageshow.window="submitting = false">
                        <partial name="_PickupPaymentChoice" model="Model.Total" />
                    </form>
                }
                else
                {
                    <a href="/checkout/payment"
                       class="btn-primary w-full">
                        Continue to payment
                    </a>
                }
            </section>
        </div>
    </div>
</div>
