{
  "name": "glimpsesofglory.web",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build:css": "tailwindcss -i ./wwwroot/assets/css/input.css -o ./wwwroot/css/site.css --minify",
    "watch:css": "tailwindcss -i ./wwwroot/assets/css/input.css -o ./wwwroot/css/site.css --watch",
    "build:js": "node -e \"const fs=require('fs');fs.mkdirSync('./wwwroot/js',{recursive:true});[['alpinejs/dist/cdn.min.js','alpine.min.js'],['@alpinejs/focus/dist/cdn.min.js','alpine-focus.min.js'],['htmx.org/dist/htmx.min.js','htmx.min.js']].forEach(([src,dst])=>fs.copyFileSync('./node_modules/'+src,'./wwwroot/js/'+dst))\"",
    "build": "npm run build:css && npm run build:js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@alpinejs/focus": "^3.17.5",
    "@tailwindcss/cli": "^4.3.3",
    "alpinejs": "^3.17.5",
    "htmx.org": "^2.0.10",
    "tailwindcss": "^4.3.3"
  }
}
