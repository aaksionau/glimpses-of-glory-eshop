@page
@model GlimpsesOfGlory.Web.Pages.Admin.LoginModel
@{
    ViewData["Title"] = "Admin login";
}

<div class="max-w-sm mx-auto py-10">
    <h1 class="text-2xl font-bold mb-4">Admin login</h1>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <p class="text-red-600 mb-4">@Model.ErrorMessage</p>
    }

    <form method="post">
        <label class="block mb-2">
            <span class="block mb-1">Password</span>
            <input type="password" asp-for="Password" class="w-full border border-black px-3 py-2" autofocus />
        </label>
        <button type="submit" class="w-full border border-black px-4 py-2 font-bold mt-2">Log in</button>
    </form>
</div>
