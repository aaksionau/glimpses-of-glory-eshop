@page "/admin/orders/{id:int}"
@model GlimpsesOfGlory.Web.Pages.Admin.Orders.DetailsModel
@{
    ViewData["Title"] = $"Admin - Order #{Model.Order.Id}";
}

<div class="py-5 max-w-2xl">
    <h1 class="text-2xl font-bold mb-4">Admin dashboard</h1>
    <partial name="/Pages/Admin/_AdminNav.cshtml" />

    <a asp-page="/Admin/Orders/Index" class="text-sm hover:underline">&larr; Back to orders</a>

    <h2 class="text-xl font-semibold my-4">Order #@Model.Order.Id</h2>

    <div class="grid gap-4 sm:grid-cols-2 mb-6">
        <div>
            <h3 class="font-semibold mb-1">Customer</h3>
            <p>@Model.Order.Address.Email</p>
            <p class="text-sm text-gray-500">Placed @Model.Order.CreatedAt.ToString("MMMM d, yyyy")</p>
        </div>
        <div>
            <h3 class="font-semibold mb-1">Shipping address</h3>
            <p>
                @Model.Order.Address.FullName<br />
                @Model.Order.Address.AddressLine1<br />
                @if (!string.IsNullOrWhiteSpace(Model.Order.Address.AddressLine2))
                {
                    @Model.Order.Address.AddressLine2<text><br /></text>
                }
                @Model.Order.Address.City, @Model.Order.Address.State @Model.Order.Address.PostalCode<br />
                @Model.Order.Address.Country
            </p>
        </div>
    </div>

    <table class="w-full text-left border-collapse mb-4">
        <thead>
            <tr class="border-b border-black/20 text-sm text-gray-500">
                <th class="py-2 pr-2">Item</th>
                <th class="py-2 pr-2">Qty</th>
                <th class="py-2 pr-2">Price</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var line in Model.Order.Lines)
            {
                <tr class="border-b border-black/10">
                    <td class="py-2 pr-2">@line.ProductName</td>
                    <td class="py-2 pr-2">@line.Quantity</td>
                    <td class="py-2 pr-2">@line.UnitPrice.ToString("C")</td>
                </tr>
            }
        </tbody>
    </table>

    <p class="text-right mb-6">
        Subtotal: @Model.Order.Subtotal.ToString("C")<br />
        Shipping: @Model.Order.ShippingCost.ToString("C")<br />
        <strong>Total: @Model.Order.Total.ToString("C")</strong>
    </p>

    <partial name="_OrderStatus" model="Model" />
</div>
