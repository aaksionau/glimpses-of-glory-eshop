@page "/checkout/payment"
@model GlimpsesOfGlory.Web.Pages.Checkout.PaymentModel
@{
    ViewData["Title"] = "Payment";
}

<div class="py-4 max-w-xl mx-auto lg:max-w-5xl">
    <h1 class="text-3xl font-bold mb-6 font-display">Checkout</h1>

    <partial name="_CheckoutSteps" model="3" />

    <div class="flex flex-col gap-6 lg:grid lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-start lg:gap-10">
        <aside class="lg:order-last lg:sticky lg:top-4">
            <partial name="_CheckoutOrderSummary" model="Model.Summary" />
        </aside>

        <div>
            <div class="flex items-center justify-between mb-4">
                <h2 class="font-semibold text-lg">Pay by card</h2>
                <a href="/checkout/review" class="text-sm text-gold-dark hover:underline">Back</a>
            </div>

            <partial name="_PaymentForm" model="Model" />
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://js.stripe.com/v3/"></script>
    <script src="~/js/checkout-payment.js" asp-append-version="true"></script>
}
