@page "/products/{slug}"
@using GlimpsesOfGlory.Abstractions.Constants
@model GlimpsesOfGlory.Web.Pages.Products.DetailsModel
@using GlimpsesOfGlory.Web.Helpers
@using GlimpsesOfGlory.Web.Dtos
@{
    ViewData["Title"] = Model.Product.Name;
    ViewData["MetaDescription"] = SeoText.Truncate(Model.Product.Description, 160);
    ViewData["OgType"] = "product";
    if (Model.Product.PhotoFileNames.Count > 0)
    {
        ViewData["OgImage"] = $"{HttpContext.Request.Scheme}://{HttpContext.Request.Host}/product-photos/{Model.Product.PhotoFileNames[0]}";
    }
}

<div class="container mx-auto px-4 py-10 md:py-16">
    <a href="/products" class="inline-flex items-center min-h-11 -ml-2 px-2 text-gold-dark hover:underline">&larr; Back to products</a>

    <div class="mt-2 grid grid-cols-1 gap-8 md:grid-cols-[minmax(0,360px)_1fr]">
        <div class="mx-auto w-full max-w-xs md:max-w-none">
            <partial name="_ProductGallery" model="Model.Product" />
        </div>

        @* The order form sits right under the price and badges, ahead of the description, so on a phone
           the call to action isn't pushed below the fold by a long description. *@
        <div>
            <h1 class="text-3xl font-bold">@Model.Product.Name</h1>
            <p class="text-2xl mt-2 text-gold-dark font-medium">@Model.Product.Price.ToString("C")</p>

            @if (Model.Product.IsPreorder)
            {
                <partial name="_PreorderBadge" model="@("inline-block mt-2")" />
                @if (Model.Product.ExpectedAvailabilityDate is { } date)
                {
                    <p class="text-ink-light text-sm mt-1 font-bold">Ships approx. @date.ToString("MMM d, yyyy")</p>
                }
            }
            else if (Model.Product.StockQuantity <= 0)
            {
                <partial name="_OutOfStockBadge" model="@("inline-block mt-2")" />
            }

            @if (Model.ErrorMessage is not null)
            {
                <p class="mt-4 text-red-600 font-medium" role="alert">@Model.ErrorMessage</p>
            }

            @if (Model.Product.IsPreorder || Model.Product.StockQuantity > 0)
            {
                var maxQuantity = Model.Product.IsPreorder ? PreorderPolicy.MaxQuantityPerLine : Model.Product.StockQuantity;
                <form method="post" asp-antiforgery="true" class="mt-6 flex flex-wrap items-center gap-3" data-testid="add-to-cart">
                    <partial name="_QuantityStepper" model="new QuantityStepperView(Model.Product.Slug, Model.Product.Name, 1, maxQuantity)" />
                    <button type="submit" class="btn-primary">
                        @(Model.Product.IsPreorder ? "Preorder" : "Add to cart")
                    </button>
                </form>
                <p class="mt-3 text-ink-light text-sm" data-testid="delivery-note">Shipping available &middot; Free local pickup</p>
            }

            <p class="mt-6 whitespace-pre-line text-ink-light" data-testid="product-description">@Model.Product.Description</p>
        </div>
    </div>
</div>

@section Scripts {
    @* The lightbox's x-trap comes from Alpine's focus plugin; the layout renders this section before
       Alpine itself, so the plugin registers first. *@
    <script src="~/js/alpine-focus.min.js" defer asp-append-version="true"></script>
}
