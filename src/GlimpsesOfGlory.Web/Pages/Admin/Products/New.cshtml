@page "/admin/products/new"
@model GlimpsesOfGlory.Web.Pages.Admin.Products.NewModel
@{
    ViewData["Title"] = "Admin - New product";
}

<div class="py-5 max-w-xl">
    <h1 class="text-2xl font-bold mb-4">Admin dashboard</h1>
    <partial name="/Pages/Admin/_AdminNav.cshtml" />

    <h2 class="text-xl font-semibold mb-4">Add product</h2>

    <form method="post" asp-antiforgery="true" class="flex flex-col gap-4">
        <div asp-validation-summary="ModelOnly" class="text-red-600"></div>

        <label class="block">
            <span class="block mb-1 font-medium">Name</span>
            <input asp-for="Input.Name" type="text" required class="w-full border border-black/20 rounded px-3 py-2" />
            <span asp-validation-for="Input.Name" class="text-red-600 text-sm"></span>
        </label>

        <label class="block">
            <span class="block mb-1 font-medium">Description</span>
            <textarea asp-for="Input.Description" rows="4" required class="w-full border border-black/20 rounded px-3 py-2"></textarea>
            <span asp-validation-for="Input.Description" class="text-red-600 text-sm"></span>
        </label>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <label class="block">
                <span class="block mb-1 font-medium">Price</span>
                <input asp-for="Input.Price" type="number" step="0.01" min="0.01" required class="w-full border border-black/20 rounded px-3 py-2" />
                <span asp-validation-for="Input.Price" class="text-red-600 text-sm"></span>
            </label>

            <label class="block">
                <span class="block mb-1 font-medium">Stock quantity</span>
                <input asp-for="Input.StockQuantity" type="number" min="0" required class="w-full border border-black/20 rounded px-3 py-2" />
                <span asp-validation-for="Input.StockQuantity" class="text-red-600 text-sm"></span>
            </label>
        </div>

        <button type="submit" class="bg-black text-white px-6 py-3 rounded-lg font-semibold mt-2">Create product</button>
    </form>
</div>
