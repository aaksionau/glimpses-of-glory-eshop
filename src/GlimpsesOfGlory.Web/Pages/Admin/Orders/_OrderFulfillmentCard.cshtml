@model GlimpsesOfGlory.Web.Pages.Admin.Orders.DetailsModel
@using GlimpsesOfGlory.Abstractions.Enums

@* Re-sent out-of-band after each htmx action: marking shipped can add a tracking number. *@
<section id="order-fulfillment" class="rounded-lg border border-black/10 bg-white p-4" aria-labelledby="order-fulfillment-heading" hx-swap-oob="@(Model.IsHtmxUpdate ? "true" : null)">
    @if (Model.Order.FulfillmentMethod == FulfillmentMethod.Pickup)
    {
        <h2 id="order-fulfillment-heading" class="font-semibold mb-2">Fulfillment: local pickup</h2>
        <p>@Model.Order.Address.FullName</p>
    }
    else
    {
        <h2 id="order-fulfillment-heading" class="font-semibold mb-2">Fulfillment: shipping</h2>
        <p>
            @Model.Order.Address.FullName<br />
            @Model.Order.Address.AddressLine1<br />
            @if (!string.IsNullOrWhiteSpace(Model.Order.Address.AddressLine2))
            {
                @Model.Order.Address.AddressLine2<text><br /></text>
            }
            @Model.Order.Address.City, @Model.Order.Address.State @Model.Order.Address.PostalCode<br />
            @Model.Order.Address.Country
        </p>
        @if (!string.IsNullOrWhiteSpace(Model.Order.TrackingNumber))
        {
            <p class="mt-2 text-sm">Tracking: <strong>@Model.Order.TrackingNumber</strong></p>
        }
    }
</section>
