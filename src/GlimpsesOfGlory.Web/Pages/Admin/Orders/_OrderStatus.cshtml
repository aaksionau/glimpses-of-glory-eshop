@model GlimpsesOfGlory.Web.Pages.Admin.Orders.DetailsModel
@using GlimpsesOfGlory.Abstractions.Dtos
@using GlimpsesOfGlory.Abstractions.Enums
@using GlimpsesOfGlory.Web.Helpers
@{
    var isPickup = Model.Order.FulfillmentMethod == FulfillmentMethod.Pickup;
}

<div id="order-status" class="border border-black/10 rounded p-4">
    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <p class="text-green-700 mb-4">@Model.StatusMessage</p>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <p class="text-red-600 mb-4" role="alert">@Model.ErrorMessage</p>
    }

    <p class="mb-4">
        Status:
        <span class="font-semibold @(Model.Order.Status switch { OrderStatus.Cancelled => "text-red-600", OrderStatus.Shipped or OrderStatus.PickedUp => "text-green-700", _ => "text-gray-700" })">
            @FulfillmentLabels.Status(Model.Order.Status, Model.Order.FulfillmentMethod)
        </span>
        @if (!string.IsNullOrWhiteSpace(Model.Order.TrackingNumber))
        {
            <text> &middot; Tracking: <strong>@Model.Order.TrackingNumber</strong></text>
        }
        <br />
        Payment:
        <span class="font-semibold @(Model.Order.IsPaid ? "text-green-700" : "text-red-600")">
            @PaymentLabels.Status(Model.Order.PaymentMethod, Model.Order.IsPaid)
        </span>
    </p>

    @if (Model.Order.NeedsRefund)
    {
        <div class="border border-red-600 bg-red-50 rounded p-3 mb-4" role="alert">
            <p class="font-semibold text-red-600">Refund required</p>
            <p class="text-sm">
                This paid card order was cancelled, but the payment isn't refunded automatically. Refund @Model.Order.Total.ToString("C") in Stripe.
                @if (Model.Order.PaymentDashboardUrl is not null)
                {
                    <a href="@Model.Order.PaymentDashboardUrl" target="_blank" rel="noopener noreferrer" class="font-semibold underline">Open payment in Stripe</a>
                }
            </p>
        </div>
    }

    @if (Model.Order.CanMarkShipped || Model.Order.CanMarkPickedUp || Model.Order.CanMarkPaid || Model.Order.CanMarkCancelled)
    {
        <div class="flex flex-wrap gap-4">
            @if (Model.Order.CanMarkShipped)
            {
                <form hx-post="/admin/orders/@Model.Order.Id?handler=MarkShipped" hx-target="#order-status" hx-swap="outerHTML" asp-antiforgery="true" class="flex flex-wrap items-end gap-2">
                    @* Pickup orders have nothing to track. *@
                    @if (!isPickup)
                    {
                        <label class="block">
                            <span class="block mb-1 text-sm">Tracking number (optional)</span>
                            <input asp-for="TrackingNumber" type="text" class="border border-black/20 rounded px-3 py-2" />
                            <span asp-validation-for="TrackingNumber" class="text-red-600 text-sm"></span>
                        </label>
                    }
                    <button type="submit" class="bg-black text-white px-4 py-2 rounded-lg font-semibold">Mark @FulfillmentLabels.ShippedStatus(Model.Order.FulfillmentMethod).ToLowerInvariant()</button>
                </form>
            }

            @if (Model.Order.CanMarkPickedUp)
            {
                <form hx-post="/admin/orders/@Model.Order.Id?handler=MarkPickedUp" hx-target="#order-status" hx-swap="outerHTML" asp-antiforgery="true">
                    <button type="submit" class="bg-black text-white px-4 py-2 rounded-lg font-semibold">Mark picked up</button>
                </form>
            }

            @if (Model.Order.CanMarkPaid)
            {
                <form hx-post="/admin/orders/@Model.Order.Id?handler=MarkPaid" hx-target="#order-status" hx-swap="outerHTML" asp-antiforgery="true">
                    <button type="submit" class="bg-black text-white px-4 py-2 rounded-lg font-semibold">Mark as paid</button>
                </form>
            }

            @if (Model.Order.CanMarkCancelled)
            {
                <form hx-post="/admin/orders/@Model.Order.Id?handler=MarkCancelled" hx-target="#order-status" hx-swap="outerHTML" hx-confirm="Cancel order #@Model.Order.Id? This can't be undone." asp-antiforgery="true">
                    <button type="submit" class="border border-red-600 text-red-600 hover:bg-red-50 px-4 py-2 rounded-lg font-semibold">Cancel order</button>
                </form>
            }
        </div>
    }
</div>
