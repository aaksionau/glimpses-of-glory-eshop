@model GlimpsesOfGlory.Web.Dtos.CheckoutAddress
@using GlimpsesOfGlory.Abstractions.Constants
@using GlimpsesOfGlory.Abstractions.Enums
@* Contact and address fields of the checkout details form. Rendered with for="Address" so the
   inputs keep their "Address." name prefix; each carries its autofill token so browsers can fill
   the whole form in one go. Relies on the enclosing form's Alpine "method" state. *@
@{
    // A partial never takes a layout; this also keeps it renderable on its own (in tests).
    Layout = null;
    // The select tag helper marks the option matching the posted value (ModelState first, then the
    // model); read the same value here so the default only applies when that matches nothing and the
    // two never select different options.
    var postedCountry = ViewData.ModelState[Html.NameFor(m => m.Country)]?.AttemptedValue ?? Model?.Country;
    var selectedCountry = ShippingCountryPolicy.SelectedOrDefault(postedCountry);
}

<label class="block">
    <span class="block mb-1 font-medium">Email</span>
    <input asp-for="Email" type="email" autocomplete="email" required
           class="w-full border border-ink/20 rounded px-3 py-2" />
    <span asp-validation-for="Email" class="text-red-600 text-sm"></span>
</label>

<label class="block">
    <span class="block mb-1 font-medium">Full name</span>
    <input asp-for="FullName" type="text" autocomplete="name" required
           class="w-full border border-ink/20 rounded px-3 py-2" />
    <span asp-validation-for="FullName" class="text-red-600 text-sm"></span>
</label>

@* Disabled (not just hidden) for pickup so the browser skips the required checks
   and doesn't post the address fields. *@
<fieldset class="flex flex-col gap-4" x-show="method === '@FulfillmentMethod.Shipping'" :disabled="method !== '@FulfillmentMethod.Shipping'">
    <label class="block">
        <span class="block mb-1 font-medium">Address line 1</span>
        <input asp-for="AddressLine1" type="text" autocomplete="address-line1" required
               class="w-full border border-ink/20 rounded px-3 py-2" />
        <span asp-validation-for="AddressLine1" class="text-red-600 text-sm"></span>
    </label>

    <label class="block">
        <span class="block mb-1 font-medium">Address line 2 <span class="text-ink-light font-normal">(optional)</span></span>
        <input asp-for="AddressLine2" type="text" autocomplete="address-line2"
               class="w-full border border-ink/20 rounded px-3 py-2" />
    </label>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <label class="block">
            <span class="block mb-1 font-medium">City</span>
            <input asp-for="City" type="text" autocomplete="address-level2" required
                   class="w-full border border-ink/20 rounded px-3 py-2" />
            <span asp-validation-for="City" class="text-red-600 text-sm"></span>
        </label>

        <label class="block">
            <span class="block mb-1 font-medium">State/Region</span>
            <input asp-for="State" type="text" autocomplete="address-level1" required
                   class="w-full border border-ink/20 rounded px-3 py-2" />
            <span asp-validation-for="State" class="text-red-600 text-sm"></span>
        </label>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <label class="block">
            <span class="block mb-1 font-medium">Postal code</span>
            <input asp-for="PostalCode" type="text" autocomplete="postal-code" required
                   class="w-full border border-ink/20 rounded px-3 py-2" />
            <span asp-validation-for="PostalCode" class="text-red-600 text-sm"></span>
        </label>

        <label class="block">
            <span class="block mb-1 font-medium">Country</span>
            @* A select of the countries we ship to, so the stored value is always one of them. *@
            <select asp-for="Country" autocomplete="country-name" required
                    class="w-full border border-ink/20 rounded px-3 py-2 bg-white">
                @foreach (var country in ShippingCountryPolicy.SupportedCountries)
                {
                    <option value="@country" selected="@(country == selectedCountry)">@country</option>
                }
            </select>
            <span asp-validation-for="Country" class="text-red-600 text-sm"></span>
        </label>
    </div>
</fieldset>
