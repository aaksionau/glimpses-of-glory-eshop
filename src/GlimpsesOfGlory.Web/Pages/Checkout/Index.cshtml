@page "/checkout"
@model GlimpsesOfGlory.Web.Pages.Checkout.IndexModel
@using GlimpsesOfGlory.Abstractions.Enums
@{
    ViewData["Title"] = "Checkout";
}

<div class="py-4 max-w-xl mx-auto lg:max-w-5xl">
    <h1 class="text-3xl font-bold mb-6 font-display">Checkout</h1>

    <partial name="_CheckoutSteps" model="1" />

    @* method is the selected delivery radio; the order summary shows that option's shipping and total. *@
    <div class="flex flex-col gap-6 lg:grid lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-start lg:gap-10"
         x-data="{ method: '@Model.Address.FulfillmentMethod' }">
        <aside class="lg:order-last lg:sticky lg:top-4">
            <partial name="_CheckoutOrderSummary" model="Model.Summary" />
        </aside>

        @* data-validate: checked in the browser by form-validation.js, which also lists the errors in
           the summary and focuses the first invalid field (including after a failed post). *@
        <form method="post" asp-antiforgery="true" class="flex flex-col gap-4" data-validate>
            <div asp-validation-summary="ModelOnly" role="alert" data-validation-summary class="text-red-600"></div>

            <fieldset class="flex flex-col gap-2">
                @* The checked option's card is highlighted through CSS (has-checked:), so it follows the radio without JavaScript. *@
                <legend class="mb-1 font-medium">Delivery</legend>
                <label class="flex items-center gap-3 border border-ink/20 rounded-lg p-4 cursor-pointer transition-colors has-checked:border-gold has-checked:bg-gold-light/30">
                    <input asp-for="Address.FulfillmentMethod" type="radio" id="fulfillment-shipping" value="@FulfillmentMethod.Shipping" x-model="method" />
                    <span>Ship to my address <span class="text-ink-light">&middot; @Model.ShippingCost.ToString("C")</span></span>
                </label>
                <label class="flex items-center gap-3 border border-ink/20 rounded-lg p-4 cursor-pointer transition-colors has-checked:border-gold has-checked:bg-gold-light/30">
                    <input asp-for="Address.FulfillmentMethod" type="radio" id="fulfillment-pickup" value="@FulfillmentMethod.Pickup" x-model="method" />
                    <span>Local pickup <span class="text-ink-light">&middot; Free, we'll email you when your order is ready</span></span>
                </label>
            </fieldset>

            <partial name="_CheckoutDetailsFields" for="Address" />

            <button type="submit" class="bg-gold hover:bg-gold-dark transition-colors text-white px-6 py-3 rounded-full font-semibold mt-2">
                Continue to review
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/form-validation.js" asp-append-version="true"></script>
}
