@model GlimpsesOfGlory.Web.Pages.Admin.Orders.DetailsModel
@using GlimpsesOfGlory.Abstractions.Orders

<div id="order-status" class="border border-black/10 rounded p-4">
    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <p class="text-green-700 mb-4">@Model.StatusMessage</p>
    }

    <p class="mb-4">
        Status:
        <span class="font-semibold @(Model.Order.Status == OrderStatus.Cancelled ? "text-red-600" : Model.Order.Status == OrderStatus.Shipped ? "text-green-700" : "text-gray-700")">
            @Model.Order.Status
        </span>
        @if (!string.IsNullOrWhiteSpace(Model.Order.TrackingNumber))
        {
            <text> &middot; Tracking: <strong>@Model.Order.TrackingNumber</strong></text>
        }
    </p>

    <div class="flex flex-wrap gap-4">
        <form hx-post="/admin/orders/@Model.Order.Id?handler=MarkShipped" hx-target="#order-status" hx-swap="outerHTML" asp-antiforgery="true" class="flex flex-wrap items-end gap-2">
            <label class="block">
                <span class="block mb-1 text-sm">Tracking number (optional)</span>
                <input asp-for="TrackingNumber" type="text" class="border border-black/20 rounded px-3 py-2" />
                <span asp-validation-for="TrackingNumber" class="text-red-600 text-sm"></span>
            </label>
            <button type="submit" class="bg-black text-white px-4 py-2 rounded-lg font-semibold">Mark shipped</button>
        </form>

        <form hx-post="/admin/orders/@Model.Order.Id?handler=MarkCancelled" hx-target="#order-status" hx-swap="outerHTML" asp-antiforgery="true">
            <button type="submit" class="border border-black px-4 py-2 rounded-lg font-semibold">Mark cancelled</button>
        </form>
    </div>
</div>
