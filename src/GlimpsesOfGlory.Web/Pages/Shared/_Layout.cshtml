@using GlimpsesOfGlory.Abstractions.Services
@inject ICartStore CartStore
@{
    var request = Context.Request;
    var path = request.Path.Value ?? "";
    string? AriaCurrent(StorefrontSection section) => StorefrontSections.AriaCurrent(section, path);
    string NavLinkClass(StorefrontSection section) =>
        "min-h-11 items-center px-3 border-b-2 transition-colors hover:text-gold-dark "
        + (AriaCurrent(section) is not null ? "border-gold text-gold-dark" : "border-transparent");
    var isUserFlowPage = path.StartsWith("/admin", StringComparison.OrdinalIgnoreCase)
        || path.StartsWith("/cart", StringComparison.OrdinalIgnoreCase)
        || path.StartsWith("/checkout", StringComparison.OrdinalIgnoreCase);
    var metaDescription = ViewData["MetaDescription"] as string;
    var canonicalUrl = ViewData["Canonical"] as string ?? $"{request.Scheme}://{request.Host}{request.Path}";
    var ogType = ViewData["OgType"] as string ?? "website";
    var ogTitle = ViewData["OgTitle"] as string ?? ViewData["Title"] as string;
    var ogDescription = ViewData["OgDescription"] as string ?? metaDescription;
    var ogImage = ViewData["OgImage"] as string;
    var cart = await CartStore.GetCartAsync(Context.RequestAborted);
    var cartItemCount = cart.TotalQuantity;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Glimpses of Glory</title>
    @if (isUserFlowPage)
    {
        <meta name="robots" content="noindex, nofollow" />
    }
    else
    {
        @if (metaDescription is not null)
        {
            <meta name="description" content="@metaDescription" />
        }
        <link rel="canonical" href="@canonicalUrl" />
        <meta property="og:type" content="@ogType" />
        @if (ogTitle is not null)
        {
            <meta property="og:title" content="@ogTitle" />
        }
        @if (ogDescription is not null)
        {
            <meta property="og:description" content="@ogDescription" />
        }
        @if (ogImage is not null)
        {
            <meta property="og:image" content="@ogImage" />
        }
        <meta property="og:url" content="@canonicalUrl" />
    }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="min-h-screen overflow-x-hidden bg-cream text-ink flex flex-col">
    <header class="sticky top-0 z-40 border-b border-ink/10 bg-cream/95 backdrop-blur">
        <div class="container mx-auto flex items-center justify-between gap-4 px-4 py-2 sm:py-3">
            <a asp-area="" asp-page="/Index" class="flex min-h-11 flex-col justify-center leading-tight">
                <span class="font-display text-xl md:text-2xl font-bold text-ink">Glimpses of Glory</span>
                <span class="hidden sm:block text-[0.65rem] tracking-widest uppercase text-gold-dark">Photography of God’s Beautiful Handiwork</span>
            </a>
            @* Each link is at least 44px tall (min-h-11) with side padding, so it is an easy tap target on a phone.
               The current section gets aria-current and a gold underline. "Home" repeats the logo link, so phones skip it. *@
            <nav aria-label="Main" class="-mr-3 flex items-center gap-1 sm:gap-2 text-sm font-medium text-ink">
                <a asp-area="" asp-page="/Index" class="@NavLinkClass(StorefrontSection.Home) hidden sm:inline-flex" aria-current="@AriaCurrent(StorefrontSection.Home)">Home</a>
                <a asp-area="" asp-page="/Products/Index" class="@NavLinkClass(StorefrontSection.Shop) inline-flex" aria-current="@AriaCurrent(StorefrontSection.Shop)">Shop</a>
                <a href="/#about" class="@NavLinkClass(StorefrontSection.None) hidden sm:inline-flex">About</a>
                <a asp-area="" asp-page="/Cart/Index" class="@NavLinkClass(StorefrontSection.Cart) inline-flex gap-1.5" aria-current="@AriaCurrent(StorefrontSection.Cart)" data-testid="header-cart">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" aria-hidden="true" focusable="false">
                        <path d="M6 6h15l-1.5 9h-12z" />
                        <path d="M6 6 5 3H2" />
                        <circle cx="9" cy="20" r="1.25" />
                        <circle cx="18" cy="20" r="1.25" />
                    </svg>
                    <span class="sr-only sm:not-sr-only">Cart</span>
                    <span id="cart-count">
                        @if (cartItemCount > 0)
                        {
                            <span class="inline-flex items-center justify-center min-w-5 h-5 px-1 rounded-full bg-gold text-white text-xs font-semibold">@cartItemCount</span>
                        }
                    </span>
                </a>
            </nav>
        </div>
    </header>
    <main class="flex-1 @(isUserFlowPage ? "container mx-auto p-4" : "")">
        @RenderBody()
    </main>
    <footer class="bg-ink text-cream mt-16">
        <div class="container mx-auto grid grid-cols-1 gap-8 px-4 py-10 sm:grid-cols-3">
            <div>
                <p class="font-display text-lg font-bold mb-2">Glimpses of Glory</p>
                <p class="text-sm text-cream/70">
                    Nature photography and calendars focusing on God’s wonderful Word and His wonder-filled works
                </p>
            </div>
            <div>
                <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-gold-light">Shop</p>
                <ul class="flex flex-col gap-1 text-sm text-cream/70">
                    <li><a asp-area="" asp-page="/Index" class="hover:text-white">Home</a></li>
                    <li><a asp-area="" asp-page="/Products/Index" class="hover:text-white">All products</a></li>
                    <li><a asp-area="" asp-page="/Cart/Index" class="hover:text-white">Your cart</a></li>
                    <li><a asp-area="" asp-page="/Privacy" class="hover:text-white">Privacy policy</a></li>
                </ul>
            </div>
            <div>
                <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-gold-light">Get in touch</p>
                <a
                    x-data="{ user: 'support', domain: 'glimpsesofglory.art' }"
                    :href="'mailto:' + user + '@@' + domain"
                    x-text="user + '@@' + domain"
                    class="mt-2 block text-sm text-gold-light hover:text-white"
                >Email us</a>
            </div>
        </div>
        <div class="border-t border-cream/10">
            <div class="container mx-auto px-4 py-4 text-center text-xs text-cream/50">
                &copy; 2026 Glimpses of Glory. All rights reserved.
            </div>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/htmx.min.js" asp-append-version="true"></script>
    <script src="~/js/alpine.min.js" defer asp-append-version="true"></script>
</body>
</html>
