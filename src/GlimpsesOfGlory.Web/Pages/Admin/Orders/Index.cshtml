@page "/admin/orders"
@model GlimpsesOfGlory.Web.Pages.Admin.Orders.IndexModel
@using GlimpsesOfGlory.Abstractions.Enums
@using GlimpsesOfGlory.Web.Helpers
@{
    ViewData["Title"] = "Orders";
}

<div>
    <div class="overflow-x-auto">
        @if (Model.Orders.Count == 0)
        {
            <p>No orders yet.</p>
        }
        else
        {
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b border-black/20 text-sm text-gray-500">
                        <th class="py-2 pr-2">Order</th>
                        <th class="py-2 pr-2">Customer</th>
                        <th class="py-2 pr-2">Items</th>
                        <th class="py-2 pr-2">Total</th>
                        <th class="py-2 pr-2">Status</th>
                        <th class="py-2 pr-2">Placed</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.Orders)
                    {
                        <tr class="border-b border-black/10">
                            <td class="py-2 pr-2">
                                <a asp-page="/Admin/Orders/Details" asp-route-id="@order.Id" class="font-medium hover:underline">#@order.Id</a>
                                @if (order.HasPreorderLines)
                                {
                                    <span class="ml-1 bg-black text-white text-xs font-semibold px-2 py-1 rounded-full">Preorder</span>
                                }
                                @if (order.FulfillmentMethod == FulfillmentMethod.Pickup)
                                {
                                    <span class="ml-1 border border-black text-xs font-semibold px-2 py-1 rounded-full">Pickup</span>
                                }
                                @if (order.NeedsRefund)
                                {
                                    <span class="ml-1 bg-red-600 text-white text-xs font-semibold px-2 py-1 rounded-full">Refund required</span>
                                }
                                @if (!order.IsPaid)
                                {
                                    <span class="ml-1 bg-red-600 text-white text-xs font-semibold px-2 py-1 rounded-full">Unpaid</span>
                                }
                            </td>
                            <td class="py-2 pr-2">@order.Email</td>
                            <td class="py-2 pr-2">@order.ItemCount</td>
                            <td class="py-2 pr-2">@order.Total.ToString("C")</td>
                            <td class="py-2 pr-2">@FulfillmentLabels.Status(order.Status, order.FulfillmentMethod)</td>
                            <td class="py-2 pr-2">@order.CreatedAt.ToString("MMM d, yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
