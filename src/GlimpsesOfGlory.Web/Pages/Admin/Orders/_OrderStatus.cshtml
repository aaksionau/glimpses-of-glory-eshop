@model GlimpsesOfGlory.Web.Pages.Admin.Orders.DetailsModel
@using GlimpsesOfGlory.Web.Helpers
@{
    var primary = OrderActions.Primary(Model.Order);
    var secondary = OrderActions.Secondary(Model.Order);

    const string PrimaryButton = "bg-black text-white hover:bg-black/80 px-4 py-2 rounded-lg font-semibold";
    const string SecondaryButton = "border border-black/20 bg-white hover:bg-gray-50 px-4 py-2 rounded-lg font-semibold";

    async Task RenderActionAsync(OrderAction action, bool isPrimary)
    {
        var label = OrderActions.Label(action);
        <form hx-post="/admin/orders/@Model.Order.Id?handler=@action" hx-target="#order-status" hx-swap="outerHTML" asp-antiforgery="true" class="flex flex-col gap-2" data-order-action="@action" data-primary="@(isPrimary ? "true" : "false")">
            @if (action == OrderAction.MarkShipped)
            {
                <div class="flex gap-2">
                    <label class="block">
                        <span class="block mb-1 text-sm">Carrier</span>
                        <select asp-for="Carrier" class="border border-black/20 rounded px-3 py-2 bg-white">
                            @foreach (var carrier in CarrierLabels.All)
                            {
                                <option value="@carrier">@CarrierLabels.Name(carrier)</option>
                            }
                        </select>
                    </label>
                    <label class="block flex-1">
                        <span class="block mb-1 text-sm">Tracking number (optional)</span>
                        <input asp-for="TrackingNumber" type="text" class="w-full border border-black/20 rounded px-3 py-2" />
                        <span asp-validation-for="TrackingNumber" class="text-red-600 text-sm"></span>
                    </label>
                </div>
            }
            <button type="submit" class="@(isPrimary ? PrimaryButton : SecondaryButton)">@label</button>
        </form>
    }
}

<section id="order-status" class="rounded-lg border border-black/10 bg-white p-4" aria-labelledby="order-actions-heading">
    <h2 id="order-actions-heading" class="font-semibold mb-2">Actions</h2>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <p class="text-green-700 mb-4" role="status">@Model.StatusMessage</p>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <p class="text-red-600 mb-4" role="alert">@Model.ErrorMessage</p>
    }

    @if (primary is { } primaryAction)
    {
        <div class="flex flex-col gap-3">
            @{ await RenderActionAsync(primaryAction, isPrimary: true); }
            @foreach (var action in secondary)
            {
                await RenderActionAsync(action, isPrimary: false);
            }
        </div>
    }
    else if (!Model.Order.CanResendConfirmation && !Model.Order.CanResendShippedEmail && !Model.Order.CanResendReadyForPickupEmail)
    {
        <p class="text-sm text-gray-500">No further actions for this order.</p>
    }

    @if (Model.Order.CanResendConfirmation || Model.Order.CanResendShippedEmail || Model.Order.CanResendReadyForPickupEmail)
    {
        @* Resending never changes the order; the result shows in the messages above. *@
        <div class="mt-4 border-t border-black/10 pt-3 flex flex-col gap-2">
            <h3 class="text-sm text-gray-500">Customer emails</h3>
            @if (Model.Order.CanResendConfirmation)
            {
                <form hx-post="/admin/orders/@Model.Order.Id?handler=ResendConfirmation" hx-target="#order-status" hx-swap="outerHTML" asp-antiforgery="true" data-order-action="ResendConfirmation">
                    <button type="submit" class="w-full @SecondaryButton">Resend confirmation</button>
                </form>
            }
            @if (Model.Order.CanResendShippedEmail)
            {
                <form hx-post="/admin/orders/@Model.Order.Id?handler=ResendShippedEmail" hx-target="#order-status" hx-swap="outerHTML" asp-antiforgery="true" data-order-action="ResendShippedEmail">
                    <button type="submit" class="w-full @SecondaryButton">Resend shipping email</button>
                </form>
            }
            @if (Model.Order.CanResendReadyForPickupEmail)
            {
                <form hx-post="/admin/orders/@Model.Order.Id?handler=ResendReadyForPickupEmail" hx-target="#order-status" hx-swap="outerHTML" asp-antiforgery="true" data-order-action="ResendReadyForPickupEmail">
                    <button type="submit" class="w-full @SecondaryButton">Resend ready-for-pickup email</button>
                </form>
            }
        </div>
    }

    @if (Model.Order.CanMarkCancelled)
    {
        <form hx-post="/admin/orders/@Model.Order.Id?handler=MarkCancelled" hx-target="#order-status" hx-swap="outerHTML" hx-confirm="Cancel order #@Model.Order.Id? This can't be undone." asp-antiforgery="true" class="mt-4 border-t border-black/10 pt-3 text-right" data-order-action="MarkCancelled">
            <button type="submit" class="min-h-11 px-2 text-sm font-semibold text-red-600 hover:text-red-700 hover:underline">Cancel order</button>
        </form>
    }
</section>

@if (Model.IsHtmxUpdate)
{
    @* Out-of-band swaps: keep the header badges, the other cards and the timeline in sync with the new status.
       Full paths: short names only resolve via the page's route, which the view-engine lookup for this
       fragment (handler PartialViewResult, string rendering) can't rely on. *@
    <partial name="/Pages/Admin/Orders/_OrderHeaderBadges.cshtml" model="Model" />
    <partial name="/Pages/Admin/Orders/_OrderFulfillmentCard.cshtml" model="Model" />
    <partial name="/Pages/Admin/Orders/_OrderPaymentCard.cshtml" model="Model" />
    <partial name="/Pages/Admin/Orders/_OrderTimeline.cshtml" model="Model" />
}
