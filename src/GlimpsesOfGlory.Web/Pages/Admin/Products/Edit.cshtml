@page "/admin/products/{id:int}/edit"
@model GlimpsesOfGlory.Web.Pages.Admin.Products.EditModel
@{
    ViewData["Title"] = "Edit product";
}

@section HeaderBadges {
    <partial name="_ProductHeaderBadges" model="Model" />
}

<div class="max-w-6xl">
    <div class="mb-4">
        <a asp-page="/Admin/Products/Index" class="text-sm hover:underline">&larr; Back to products</a>
    </div>

    @* One column on mobile; details and photos on the left and visibility/inventory on the right from lg up. *@
    <div class="grid gap-6 lg:grid-cols-3 lg:items-start">
        <div class="flex flex-col gap-6 lg:col-span-2">
            <partial name="_ProductForm" model="Model" />

            <section class="rounded-lg border border-black/10 bg-white p-4" aria-labelledby="product-photos-heading">
                <h2 id="product-photos-heading" class="font-semibold">Photos</h2>
                <p class="mb-3 text-sm text-gray-500">The first photo is the main image on the storefront.</p>
                <partial name="_PhotoList" model="new GlimpsesOfGlory.Web.Pages.Admin.Products.PhotoListViewModel(Model.Id, Model.Photos)" />
            </section>
        </div>

        <partial name="_ProductSidebar" model="Model" />
    </div>
</div>
