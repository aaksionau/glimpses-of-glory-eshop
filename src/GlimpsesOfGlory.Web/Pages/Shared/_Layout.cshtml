@{
    var request = Context.Request;
    var path = request.Path.Value ?? "";
    var isUserFlowPage = path.StartsWith("/admin", StringComparison.OrdinalIgnoreCase)
        || path.StartsWith("/cart", StringComparison.OrdinalIgnoreCase)
        || path.StartsWith("/checkout", StringComparison.OrdinalIgnoreCase);
    var metaDescription = ViewData["MetaDescription"] as string;
    var canonicalUrl = ViewData["Canonical"] as string ?? $"{request.Scheme}://{request.Host}{request.Path}";
    var ogType = ViewData["OgType"] as string ?? "website";
    var ogTitle = ViewData["OgTitle"] as string ?? ViewData["Title"] as string;
    var ogDescription = ViewData["OgDescription"] as string ?? metaDescription;
    var ogImage = ViewData["OgImage"] as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Glimpses of Glory</title>
    @if (isUserFlowPage)
    {
        <meta name="robots" content="noindex, nofollow" />
    }
    else
    {
        @if (metaDescription is not null)
        {
            <meta name="description" content="@metaDescription" />
        }
        <link rel="canonical" href="@canonicalUrl" />
        <meta property="og:type" content="@ogType" />
        @if (ogTitle is not null)
        {
            <meta property="og:title" content="@ogTitle" />
        }
        @if (ogDescription is not null)
        {
            <meta property="og:description" content="@ogDescription" />
        }
        @if (ogImage is not null)
        {
            <meta property="og:image" content="@ogImage" />
        }
        <meta property="og:url" content="@canonicalUrl" />
    }
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-white text-black">
    <header class="border-b border-black">
        <nav class="container mx-auto flex gap-4 p-4">
            <a class="font-bold" asp-area="" asp-page="/Index">Glimpses of Glory</a>
            <a asp-area="" asp-page="/Products/Index">Products</a>
            <a asp-area="" asp-page="/Cart/Index">Cart</a>
            <a asp-area="" asp-page="/Privacy">Privacy</a>
        </nav>
    </header>
    <main class="container mx-auto p-4">
        @RenderBody()
    </main>
    <footer class="border-t border-black mt-5">
        <div class="container mx-auto p-4 text-center">
            &copy; 2026 Glimpses of Glory
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/htmx.min.js" asp-append-version="true"></script>
    <script src="~/js/alpine.min.js" defer asp-append-version="true"></script>
</body>
</html>
