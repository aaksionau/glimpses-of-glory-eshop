@model GlimpsesOfGlory.Web.Pages.Admin.Orders.DetailsModel

@* The customer's contact details; the optional phone only shows when given. *@
<section class="rounded-lg border border-black/10 bg-white p-4" aria-labelledby="order-customer-heading">
    <h2 id="order-customer-heading" class="font-semibold mb-2">Customer</h2>
    <p>@Model.Order.Address.FullName</p>
    <p><a href="mailto:@Model.Order.Address.Email" class="hover:underline">@Model.Order.Address.Email</a></p>
    @if (Model.Order.Address.Phone is { } phone)
    {
        <p><a href="tel:@phone" class="hover:underline">@phone</a></p>
    }
    <p class="text-sm text-gray-500">Placed @Model.Order.Timestamps.CreatedAt.ToString("MMMM d, yyyy")</p>
</section>
