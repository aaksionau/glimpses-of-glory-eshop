@model decimal
@using GlimpsesOfGlory.Abstractions.Enums
@using GlimpsesOfGlory.Web.Helpers
@{
    // A partial never takes a layout; this also keeps it renderable on its own (in tests).
    Layout = null;
}
@* The payment choice for pickup orders, inside Review's form whose Alpine state holds whether the
   form is `submitting`. The single button's text follows the checked radio through CSS (`group-has-`),
   so it stays right without JavaScript; Alpine only adds the "Placing order…" state. *@
<div class="group flex flex-col gap-4">
<fieldset class="flex flex-col gap-2">
    <legend class="mb-2 font-semibold text-lg">How would you like to pay?</legend>
    <label class="flex items-start gap-3 border border-ink/20 rounded-lg p-4 cursor-pointer has-checked:border-gold-dark">
        <input type="radio" name="paymentMethod" id="payment-card" value="@PaymentMethod.Card" checked class="mt-1" />
        <span>
            <span class="block font-medium">Card now</span>
            <span class="block text-sm text-ink-light">Pay securely by card on the next step. Your order is placed once the payment goes through.</span>
        </span>
    </label>
    <label class="flex items-start gap-3 border border-ink/20 rounded-lg p-4 cursor-pointer has-checked:border-gold-dark">
        <input type="radio" name="paymentMethod" id="payment-cash" value="@PaymentMethod.Cash" class="mt-1" />
        <span>
            <span class="block font-medium">Cash when you collect</span>
            <span class="block text-sm text-ink-light">Your order is placed now. @PaymentLabels.CashDueNote(Model)</span>
        </span>
    </label>
</fieldset>

<button type="submit" x-bind:disabled="submitting"
        class="btn-primary w-full">
    <span class="group-has-[#payment-cash:checked]:hidden">Continue to payment</span>
    <span class="hidden group-has-[#payment-cash:checked]:inline" x-text="submitting ? 'Placing order…' : 'Place order'">Place order</span>
</button>
</div>
