@model GlimpsesOfGlory.Abstractions.Dtos.OrderReadyForPickupView
@using GlimpsesOfGlory.Web.Helpers
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Order Ready for Pickup</title>
</head>
<body style="font-family: sans-serif; color: #1f2937;">
    <h1>Your order is ready for pickup, @Model.Address.FullName!</h1>
    <p>Order #@Model.OrderId is ready to collect.</p>
    @if (!Model.IsPaid)
    {
        <p><strong>@PaymentLabels.CashDueNote(Model.Total)</strong></p>
    }

    <table style="width: 100%; border-collapse: collapse;">
        <thead>
            <tr>
                <th style="text-align: left; border-bottom: 1px solid #d1d5db;">Item</th>
                <th style="text-align: right; border-bottom: 1px solid #d1d5db;">Qty</th>
                <th style="text-align: right; border-bottom: 1px solid #d1d5db;">Price</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var line in Model.Lines)
            {
                <tr>
                    <td>@line.ProductName</td>
                    <td style="text-align: right;">@line.Quantity</td>
                    <td style="text-align: right;">@line.UnitPrice.ToString("C")</td>
                </tr>
            }
        </tbody>
    </table>

    <p style="text-align: right; margin-top: 1rem;">
        <strong>Total: @Model.Total.ToString("C")</strong>
    </p>
</body>
</html>
