@model GlimpsesOfGlory.Web.Pages.Admin.Products.ProductFormInput

<label class="block">
    <span class="block mb-1 font-medium">Name</span>
    <input asp-for="Name" type="text" required class="w-full border border-black/20 rounded px-3 py-2" />
    <span asp-validation-for="Name" class="text-red-600 text-sm"></span>
</label>

<label class="block">
    <span class="block mb-1 font-medium">Description</span>
    <textarea asp-for="Description" rows="4" required class="w-full border border-black/20 rounded px-3 py-2"></textarea>
    <span asp-validation-for="Description" class="text-red-600 text-sm"></span>
</label>

<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <label class="block">
        <span class="block mb-1 font-medium">Price</span>
        <input asp-for="Price" type="number" step="0.01" min="0.01" required class="w-full border border-black/20 rounded px-3 py-2" />
        <span asp-validation-for="Price" class="text-red-600 text-sm"></span>
    </label>

    <label class="block">
        <span class="block mb-1 font-medium">Stock quantity</span>
        <input asp-for="StockQuantity" type="number" min="0" required class="w-full border border-black/20 rounded px-3 py-2" />
        <span asp-validation-for="StockQuantity" class="text-red-600 text-sm"></span>
    </label>
</div>

<div x-data="{ isPreorder: @(Model.IsPreorder ? "true" : "false") }">
    <label class="flex items-center gap-2">
        <input asp-for="IsPreorder" type="checkbox" x-model="isPreorder" class="w-4 h-4" />
        <span class="font-medium">Preorder (sell before stock arrives)</span>
    </label>

    <label class="block mt-2" x-show="isPreorder" x-cloak>
        <span class="block mb-1 font-medium">Expected availability date (optional)</span>
        <input asp-for="ExpectedAvailabilityDate" type="date" class="w-full border border-black/20 rounded px-3 py-2" />
        <span asp-validation-for="ExpectedAvailabilityDate" class="text-red-600 text-sm"></span>
    </label>
</div>
