@model GlimpsesOfGlory.Web.Pages.Admin.Orders.DetailsModel
@using GlimpsesOfGlory.Abstractions.Enums
@using GlimpsesOfGlory.Web.Helpers

@* Re-sent out-of-band after each htmx action: marking shipped can add a tracking number. *@
<section id="order-fulfillment" class="rounded-lg border border-black/10 bg-white p-4" aria-labelledby="order-fulfillment-heading" hx-swap-oob="@Model.OutOfBandSwap">
    @if (Model.Order.FulfillmentMethod == FulfillmentMethod.Pickup)
    {
        <h2 id="order-fulfillment-heading" class="font-semibold mb-2">Fulfillment: local pickup</h2>
        <p>@Model.Order.Address.FullName</p>
    }
    else
    {
        <h2 id="order-fulfillment-heading" class="font-semibold mb-2">Fulfillment: shipping</h2>
        <partial name="~/Pages/Shared/_ShippingAddress.cshtml" model="Model.Order.Address" />
        @if (!string.IsNullOrWhiteSpace(Model.Order.TrackingNumber))
        {
            <p class="mt-2 text-sm">
                Tracking@(Model.Order.Carrier is { } carrier ? $" ({CarrierLabels.Name(carrier)})" : ""):
                @if (Model.Order.TrackingUrl is { } trackingUrl)
                {
                    <a href="@trackingUrl" target="_blank" rel="noopener noreferrer" class="font-semibold underline">@Model.Order.TrackingNumber</a>
                }
                else
                {
                    <strong>@Model.Order.TrackingNumber</strong>
                }
            </p>
        }
    }
</section>
