@page "/checkout/confirmation"
@model GlimpsesOfGlory.Web.Pages.Checkout.ConfirmationModel
@{
    ViewData["Title"] = "Order confirmation";
}

<div class="py-4 max-w-xl mx-auto">
    @* The live region stays in place while payment is confirmed; only its contents change, so the result is announced politely. *@
    <div id="confirmation-status" aria-live="polite">
        <partial name="_ConfirmationResult" model="Model" />
    </div>
    <partial name="_PaymentPoll" model="Model" />
</div>
