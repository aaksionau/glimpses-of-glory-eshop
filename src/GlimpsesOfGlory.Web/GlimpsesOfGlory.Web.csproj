<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\GlimpsesOfGlory.Core\GlimpsesOfGlory.Core.csproj" />
    <ProjectReference Include="..\GlimpsesOfGlory.Abstractions\GlimpsesOfGlory.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Required by `dotnet ef` tooling, which needs this package in the startup project.
         PrivateAssets keeps it out of the build output; no Core/EF types are used from Web code. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Compressed static-asset variants serve empty bodies under `dotnet run` on
         the current SDK (net10.0 preview). Disabling avoids that until it's fixed
         upstream; a reverse proxy in front of Dokploy can still gzip responses. -->
    <CompressionEnabled>false</CompressionEnabled>
  </PropertyGroup>

</Project>
