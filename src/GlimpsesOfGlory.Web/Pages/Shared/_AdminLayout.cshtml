@using GlimpsesOfGlory.Web.Helpers
@{
    var currentSection = AdminSections.FromPath(Context.Request.Path.Value);
    var title = ViewData["Title"] as string ?? "Admin";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@title - Admin - Glimpses of Glory</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-gray-100 text-gray-900 md:flex" x-data="{ menuOpen: false }">
    <aside class="bg-gray-900 text-white md:sticky md:top-0 md:h-screen md:w-60 md:shrink-0 md:overflow-y-auto">
        <div class="flex items-center justify-between px-4 py-3 md:py-5">
            <a href="/admin" class="font-semibold tracking-wide">Glimpses of Glory <span class="text-gray-400 font-normal">Admin</span></a>
            <button type="button"
                    class="md:hidden rounded-md border border-white/20 px-3 py-1 text-sm"
                    aria-controls="admin-sidebar-nav"
                    :aria-expanded="menuOpen.toString()"
                    x-on:click="menuOpen = !menuOpen">Menu</button>
        </div>
        <div id="admin-sidebar-nav" class="hidden px-3 pb-4 md:block" :class="{ 'hidden': !menuOpen }">
            <partial name="/Pages/Admin/_AdminSidebarNav.cshtml" model="currentSection" />
        </div>
    </aside>
    <div class="flex-1 min-w-0">
        <header class="border-b border-gray-200 bg-white px-4 py-4 md:px-8">
            <h1 class="text-2xl font-semibold">@title</h1>
        </header>
        <main class="px-4 py-6 md:px-8">
            @RenderBody()
        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/htmx.min.js" asp-append-version="true"></script>
    <script src="~/js/alpine.min.js" defer asp-append-version="true"></script>
</body>
</html>
