# Copy to .env for local development, or set these as environment variables
# in Dokploy's app configuration for production. Never commit real values.

# PostgreSQL connection string (ASP.NET Core config binds double-underscore
# env vars to nested keys, so this maps to ConnectionStrings:Default).
ConnectionStrings__Default=Host=localhost;Port=5432;Database=glimpsesofglory;Username=postgres;Password=changeme

# Stripe (test-mode keys for local/dev; live keys in production)
Stripe__PublishableKey=
Stripe__SecretKey=
Stripe__WebhookSecret=

# IONOS SMTP mailbox used for order/shipping emails
Smtp__Host=
Smtp__Port=587
Smtp__Username=
Smtp__Password=
Smtp__FromAddress=

# Single admin credential for the /admin area (store a hash, not plaintext)
Admin__PasswordHash=
