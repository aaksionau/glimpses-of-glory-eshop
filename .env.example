# Copy to .env for local development, or set these as environment variables
# in Dokploy's app configuration for production. Never commit real values.

# PostgreSQL connection string (ASP.NET Core config binds double-underscore
# env vars to nested keys, so this maps to ConnectionStrings:Default).
ConnectionStrings__Default=Host=localhost;Port=5432;Database=glimpsesofglory;Username=postgres;Password=changeme

# Stripe (test-mode keys for local/dev; live keys in production)
Stripe__PublishableKey=
Stripe__SecretKey=
Stripe__WebhookSecret=

# Resend (https://resend.com) API key and sender for order/shipping emails.
# FromAddress must be on a domain verified in Resend, e.g. "Glimpses of Glory <orders@example.com>".
Resend__ApiKey=
Resend__FromAddress=

# Single admin credential for the /admin area (store a hash, not plaintext).
# Generate with: dotnet run --project src/GlimpsesOfGlory.Web -- hash-password "<password>"
Admin__PasswordHash=

# Local-disk path where product photos are stored, served at /product-photos.
# Defaults to App_Data/product-photos under the app's content root if unset.
# In production, point this at a Dokploy-mounted persistent volume so photos
# survive redeploys.
ProductPhotos__StoragePath=
