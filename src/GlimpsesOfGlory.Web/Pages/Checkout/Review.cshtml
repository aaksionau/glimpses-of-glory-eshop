@page "/checkout/review"
@model GlimpsesOfGlory.Web.Pages.Checkout.ReviewModel
@using GlimpsesOfGlory.Web.Helpers
@{
    ViewData["Title"] = "Review order";
}

<div class="py-4 max-w-xl mx-auto">
    <h1 class="text-3xl font-bold mb-6 font-display">Checkout</h1>

    <partial name="_CheckoutSteps" model="2" />

    <section class="mb-6">
        <div class="flex items-center justify-between">
            <h2 class="font-semibold text-lg">@(Model.Address.IsPickup ? "Local pickup" : "Shipping to")</h2>
            <a href="/checkout" class="text-sm text-gold-dark hover:underline">Edit</a>
        </div>
        <p class="text-ink-light mt-1">
            @Model.Address.FullName<br />
            @if (!Model.Address.IsPickup)
            {
                <text>
                    @Model.Address.AddressLine1<br />
                    @if (!string.IsNullOrWhiteSpace(Model.Address.AddressLine2))
                    {
                        @Model.Address.AddressLine2<br />
                    }
                    @Model.Address.City, @Model.Address.State @Model.Address.PostalCode<br />
                    @Model.Address.Country<br />
                </text>
            }
            @Model.Address.Email
        </p>
    </section>

    <section>
        <h2 class="font-semibold text-lg mb-2">Order summary</h2>
        <div class="flex flex-col gap-3">
            @foreach (var line in Model.Cart.Lines)
            {
                <div class="flex items-center gap-4 border-b border-ink/10 pb-3">
                    @if (line.ThumbnailFileName is not null)
                    {
                        <img src="/product-photos/@line.ThumbnailFileName" alt="@line.ProductName" class="w-14 h-14 object-cover rounded-lg flex-shrink-0" />
                    }
                    else
                    {
                        <div class="w-14 h-14 bg-cream-dark rounded-lg flex-shrink-0"></div>
                    }
                    <div class="flex-1">
                        <p class="font-medium">@line.ProductName</p>
                        <p class="text-ink-light text-sm">Qty @line.Quantity &times; @line.UnitPrice.ToString("C")</p>
                    </div>
                    <p class="font-medium">@((line.UnitPrice * line.Quantity).ToString("C"))</p>
                </div>
            }
        </div>

        <div class="mt-4 flex flex-col items-end gap-1">
            <p>Subtotal: <span class="font-medium">@Model.Cart.Subtotal.ToString("C")</span></p>
            <p>@FulfillmentLabels.CostLabel(Model.Address.FulfillmentMethod): <span class="font-medium">@Model.ShippingCost.ToString("C")</span></p>
            <p class="text-lg font-bold">Total: @Model.Total.ToString("C")</p>
        </div>
    </section>

    <section class="mt-6">
        @if (Model.Address.IsPickup)
        {
            <h2 class="font-semibold text-lg mb-2">How would you like to pay?</h2>
        }
        <a href="/checkout/payment"
           class="block text-center w-full bg-gold hover:bg-gold-dark transition-colors text-white px-6 py-3 rounded-full font-semibold">
            @(Model.Address.IsPickup ? "Pay by card" : "Continue to payment")
        </a>
        @if (Model.Address.IsPickup)
        {
            @* Cash is only offered for local pickup - it's paid in person when collecting.
               Disabled once submitted so a double click can't place the order twice. *@
            <form method="post" asp-page-handler="PlaceCashOrder" class="mt-3"
                  x-data="{ submitting: false }" x-on:submit="submitting = true">
                <button type="submit" x-bind:disabled="submitting"
                        class="w-full border border-gold-dark text-gold-dark hover:bg-gold/10 transition-colors px-6 py-3 rounded-full font-semibold disabled:opacity-50 disabled:cursor-not-allowed">
                    <span x-text="submitting ? 'Placing order…' : 'Place order & pay cash at pickup'">Place order &amp; pay cash at pickup</span>
                </button>
            </form>
            <p class="text-ink-light text-sm text-center mt-2">@PaymentLabels.CashDueNote(Model.Total)</p>
        }
    </section>
</div>
