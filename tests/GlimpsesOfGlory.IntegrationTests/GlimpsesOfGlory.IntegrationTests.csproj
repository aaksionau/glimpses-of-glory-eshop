<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Test doubles shared with GlimpsesOfGlory.UnitTests live once, in tests/TestSupport, and are compiled
       into both projects. Doubles only this project uses live in it. -->
  <ItemGroup>
    <Compile Include="../TestSupport/*.cs" Link="TestSupport/%(Filename)%(Extension)" />
    <Using Include="GlimpsesOfGlory.TestSupport" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GlimpsesOfGlory.Core\GlimpsesOfGlory.Core.csproj" />
    <ProjectReference Include="..\..\src\GlimpsesOfGlory.Infrastructure\GlimpsesOfGlory.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\GlimpsesOfGlory.Web\GlimpsesOfGlory.Web.csproj" />
  </ItemGroup>

</Project>
