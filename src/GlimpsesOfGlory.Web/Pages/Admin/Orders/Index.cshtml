@page "/admin/orders"
@model GlimpsesOfGlory.Web.Pages.Admin.Orders.IndexModel
@using GlimpsesOfGlory.Abstractions.Enums
@using GlimpsesOfGlory.Web.Helpers
@{
    ViewData["Title"] = "Orders";
    var now = DateTimeOffset.UtcNow;
}

<nav aria-label="Order status" class="mb-4 border-b border-black/20">
    <ul class="flex flex-wrap gap-1 -mb-px">
        @foreach (var tab in AdminOrderTabs.Links)
        {
            var isCurrent = tab.Tab == Model.CurrentTab.Tab;
            <li>
                <a href="@Model.State.HrefForTab(tab.Tab)" aria-current="@(isCurrent ? "page" : null)"
                   class="inline-flex items-center gap-2 px-3 py-2 border-b-2 text-sm @(isCurrent ? "border-black font-medium" : "border-transparent text-gray-600 hover:text-black hover:border-black/30")">
                    @tab.Label
                    <span class="rounded-full px-2 text-xs tabular-nums @(isCurrent ? "bg-black text-white" : "bg-gray-100 text-gray-700")">@Model.Counts.For(tab.Tab)</span>
                </a>
            </li>
        }
    </ul>
</nav>

<form method="get" action="/admin/orders" role="search" class="mb-4 flex flex-wrap items-end gap-3">
    @if (Model.State.Tab != AdminOrderTabs.Default)
    {
        <input type="hidden" name="status" value="@Model.CurrentTab.Slug" />
    }
    <div>
        <label for="order-search" class="block text-sm text-gray-600">Search orders</label>
        <input id="order-search" type="search" name="q" value="@Model.State.Search" placeholder="Order #, email or name"
               class="w-72 max-w-full border border-black/30 px-2 py-1" />
    </div>
    <label class="inline-flex items-center gap-2 py-1 text-sm">
        <input type="checkbox" name="preorder" value="true" checked="@Model.State.PreorderOnly" />
        Preorders only
    </label>
    <label class="inline-flex items-center gap-2 py-1 text-sm">
        <input type="checkbox" name="tofulfill" value="true" checked="@Model.State.ToFulfillOnly" />
        To fulfill
    </label>
    <label class="inline-flex items-center gap-2 py-1 text-sm">
        <input type="checkbox" name="unpaidcash" value="true" checked="@Model.State.UnpaidCashOnly" />
        Unpaid cash
    </label>
    <button type="submit" class="border border-black px-3 py-1 text-sm hover:bg-black hover:text-white">Search</button>
    @if (Model.State.IsFiltered)
    {
        <a href="@Model.State.ClearedHref" class="py-1 text-sm underline">Clear</a>
    }
</form>

<div class="overflow-x-auto">
    @if (Model.Orders.Orders.Count == 0)
    {
        <p>@(Model.State.IsFiltered ? "No orders match your search." : Model.CurrentTab.EmptyMessage)</p>
    }
    else
    {
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="border-b border-black/20 text-sm text-gray-500">
                    <th scope="col" class="py-2 pl-3 pr-2">Order</th>
                    <th scope="col" class="py-2 pr-2">Customer</th>
                    <th scope="col" class="py-2 pr-2 text-right">Items</th>
                    <th scope="col" class="py-2 pr-4 text-right">Total</th>
                    <th scope="col" class="py-2 pr-2">Status</th>
                    <th scope="col" class="py-2 pr-2">Payment</th>
                    <th scope="col" class="py-2 pr-2">Placed</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model.Orders.Orders)
                {
                    @* The order link stretches over the whole row (after:absolute inset-0), so the row is
                       clickable anywhere while the link stays the single keyboard focus stop. *@
                    <tr class="relative border-b border-black/10 hover:bg-gray-50 @(order.NeedsAction ? "bg-amber-50/70" : "")">
                        <td class="py-2 pl-3 pr-2 border-l-4 @(order.NeedsAction ? "border-l-amber-400" : "border-l-transparent")">
                            <a asp-page="/Admin/Orders/Details" asp-route-id="@order.Id"
                               class="font-medium hover:underline outline-none after:absolute after:inset-0 after:content-[''] focus-visible:after:outline-2 focus-visible:after:-outline-offset-2 focus-visible:after:outline-black">
                                #@order.Id
                                @if (order.NeedsAction)
                                {
                                    <span class="sr-only">(needs action)</span>
                                }
                            </a>
                            <span class="ml-1 inline-flex flex-wrap gap-1 align-middle">
                                @if (order.HasPreorderLines)
                                {
                                    <partial name="_Badge" model="OrderBadges.Preorder" />
                                    @if (order.EarliestExpectedAvailability is { } availableFrom)
                                    {
                                        <span class="text-xs text-gray-600">@PreorderNoteFormatter.EarliestAvailability(availableFrom)</span>
                                    }
                                }
                                @if (order.FulfillmentMethod == FulfillmentMethod.Pickup)
                                {
                                    <partial name="_Badge" model="OrderBadges.Pickup" />
                                }
                                @if (order.HasInternalNote)
                                {
                                    <span class="inline-flex items-center text-gray-600" title="Has an internal note" data-internal-note="true">
                                        <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4">
                                            <path d="M4 3a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h1v3l4-3h7a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2H4Zm2 4h8a1 1 0 1 1 0 2H6a1 1 0 0 1 0-2Zm0 3h5a1 1 0 1 1 0 2H6a1 1 0 1 1 0-2Z" />
                                        </svg>
                                        <span class="sr-only">Has an internal note</span>
                                    </span>
                                }
                                @if (order.NeedsRefund)
                                {
                                    <partial name="_Badge" model="OrderBadges.RefundRequired" />
                                }
                            </span>
                        </td>
                        <td class="py-2 pr-2">
                            <div>@order.CustomerName</div>
                            <div class="text-sm text-gray-500">@order.Email</div>
                        </td>
                        <td class="py-2 pr-2 text-right tabular-nums">@order.ItemCount</td>
                        <td class="py-2 pr-4 text-right tabular-nums">@order.Total.ToString("C")</td>
                        <td class="py-2 pr-2"><partial name="_Badge" model="OrderBadges.Status(order.Status, order.FulfillmentMethod)" /></td>
                        <td class="py-2 pr-2"><partial name="_Badge" model="OrderBadges.Payment(order.IsPaid)" /></td>
                        <td class="py-2 pr-2 whitespace-nowrap text-sm">
                            <time datetime="@order.CreatedAt.ToString("o")" title="@RelativeTime.FullTimestamp(order.CreatedAt)">@RelativeTime.Format(order.CreatedAt, now)</time>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <nav aria-label="Pagination" class="mt-4 flex items-center justify-between gap-4 text-sm">
            <p class="text-gray-600">
                Showing @Model.Orders.FirstItem&ndash;@Model.Orders.LastItem of @Model.Orders.TotalCount
                @(Model.Orders.TotalCount == 1 ? "order" : "orders")
            </p>
            @if (Model.Orders.TotalPages > 1)
            {
                <div class="flex items-center gap-3">
                    @if (Model.Orders.HasPrevious)
                    {
                        <a href="@Model.State.HrefForPage(Model.Orders.Page - 1)" rel="prev" class="border border-black/30 px-3 py-1 hover:border-black">Previous</a>
                    }
                    <span class="tabular-nums">Page @Model.Orders.Page of @Model.Orders.TotalPages</span>
                    @if (Model.Orders.HasNext)
                    {
                        <a href="@Model.State.HrefForPage(Model.Orders.Page + 1)" rel="next" class="border border-black/30 px-3 py-1 hover:border-black">Next</a>
                    }
                </div>
            }
        </nav>
    }
</div>
