@model GlimpsesOfGlory.Web.Pages.Checkout.PaymentModel
@using GlimpsesOfGlory.Web.Helpers
@{
    // A partial never takes a layout; this also keeps it renderable on its own (in tests).
    Layout = null;
}
@*
   The card form driven by wwwroot/js/checkout-payment.js. The Pay button stays disabled until the
   Stripe Payment Element is ready; while a payment is confirming it shows a spinner and
   "Processing…" with aria-busy. Errors (a declined card, or the form failing to load) go in
   #payment-error, which is a live region the script also scrolls into view and focuses.
*@
<div id="payment-form"
     data-publishable-key="@Model.PublishableKey"
     data-client-secret="@Model.ClientSecret"
     data-load-error="@CheckoutMessages.PaymentFormUnavailable"
     data-payment-error="@CheckoutMessages.PaymentFailed">
    <div id="payment-error" role="alert" tabindex="-1"
         class="text-red-600 text-sm mb-4 scroll-mt-4 empty:hidden focus:outline-none"></div>

    <div id="payment-element" class="mb-4"></div>

    <noscript>
        <p class="text-red-600 text-sm mb-4">Card payment needs JavaScript. Turn it on and refresh this page.</p>
    </noscript>

    <button id="submit-payment" type="button" disabled aria-busy="false"
            class="btn-primary w-full">
        <svg data-processing hidden class="h-5 w-5 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 0 1 8-8v4a4 4 0 0 0-4 4H4z"></path>
        </svg>
        <span data-processing hidden>@CheckoutMessages.PaymentProcessing</span>
        <span data-idle>Pay @Model.AmountDue.ToString("C")</span>
    </button>

    @* Trust cues next to the Pay button: who handles the card, and which cards are taken. *@
    <div class="mt-4 flex flex-col items-center gap-2 text-sm text-ink-light" data-testid="payment-trust">
        <p class="inline-flex items-center gap-1.5">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="5" y="11" width="14" height="10" rx="2"></rect>
                <path d="M8 11V7a4 4 0 0 1 8 0v4"></path>
            </svg>
            Secure payment by Stripe. We never see or store your card number.
        </p>
        <ul class="flex flex-wrap justify-center gap-2" aria-label="Accepted cards">
            @foreach (var card in PaymentLabels.AcceptedCards)
            {
                <li class="rounded border border-ink/20 bg-white px-2 py-0.5 text-xs font-semibold text-ink">@card</li>
            }
        </ul>
    </div>
</div>
