@model GlimpsesOfGlory.Web.Pages.Admin.Products.EditModel

@* A failed save leaves the posted values in the fields, so they start out flagged as unsaved. *@
<section id="product-form" class="rounded-lg border border-black/10 bg-white p-4" aria-labelledby="product-details-heading">
    <h2 id="product-details-heading" class="font-semibold mb-3">Details</h2>

    <form hx-post="/admin/products/@Model.Id/edit" hx-target="#product-form" hx-swap="outerHTML" hx-disabled-elt="find button[type='submit']" asp-antiforgery="true"
          class="flex flex-col gap-4"
          x-data="{ dirty: @(ViewData.ModelState.IsValid ? "false" : "true") }" x-on:input="dirty = true" x-on:change="dirty = true">
        <div asp-validation-summary="ModelOnly" class="text-red-600"></div>

        <partial name="_ProductFields" for="Input" />

        <div class="mt-2 flex flex-wrap items-center gap-3">
            <button type="submit" class="bg-black text-white hover:bg-black/80 px-6 py-3 rounded-lg font-semibold disabled:opacity-50">Save changes</button>
            <span x-show="dirty" x-cloak class="text-sm text-amber-700">Unsaved changes</span>
            @if (!string.IsNullOrEmpty(Model.SavedMessage))
            {
                <span role="status" x-show="!dirty" class="text-sm text-green-700">@Model.SavedMessage</span>
            }
        </div>
    </form>
</section>

@if (Model.IsHtmxUpdate)
{
    <partial name="_ProductSidebar" model="Model" />
}
