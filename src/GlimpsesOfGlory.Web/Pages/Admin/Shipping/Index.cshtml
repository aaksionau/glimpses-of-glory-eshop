@page "/admin/shipping"
@model GlimpsesOfGlory.Web.Pages.Admin.Shipping.IndexModel
@{
    ViewData["Title"] = "Admin - Shipping rates";
}

<div class="py-5">
    <h1 class="text-2xl font-bold mb-4">Admin dashboard</h1>
    <partial name="/Pages/Admin/_AdminNav.cshtml" />

    <h2 class="text-xl font-semibold mb-4">Shipping rates</h2>
    <p class="text-gray-700 text-sm mb-4">
        The tier whose minimum quantity is highest (and no more than the cart's total item count) is applied.
    </p>

    <partial name="_ShippingForm" model="Model" />
</div>
