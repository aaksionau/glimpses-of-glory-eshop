@page "/checkout/confirmation"
@model GlimpsesOfGlory.Web.Pages.Checkout.ConfirmationModel
@{
    ViewData["Title"] = "Order confirmation";
}

@if (Model.Order is { } order)
{
    <div class="py-4 max-w-xl mx-auto">
        <h1 class="text-3xl font-bold mb-2">Thank you for your order!</h1>
        <p class="text-gray-600 mb-6">Order #@order.OrderId &middot; @order.CreatedAt.ToLocalTime().ToString("f")</p>

        <section class="mb-6">
            <h2 class="font-semibold text-lg">Shipping to</h2>
            <p class="text-gray-700 mt-1">
                @order.Address.FullName<br />
                @order.Address.AddressLine1<br />
                @if (!string.IsNullOrWhiteSpace(order.Address.AddressLine2))
                {
                    @order.Address.AddressLine2<br />
                }
                @order.Address.City, @order.Address.State @order.Address.PostalCode<br />
                @order.Address.Country<br />
                @order.Address.Email
            </p>
        </section>

        <section>
            <h2 class="font-semibold text-lg mb-2">Order summary</h2>
            <div class="flex flex-col gap-3">
                @foreach (var line in order.Lines)
                {
                    <div class="flex items-center justify-between border-b border-black/10 pb-3">
                        <div>
                            <p class="font-medium">@line.ProductName</p>
                            <p class="text-gray-600 text-sm">Qty @line.Quantity &times; @line.UnitPrice.ToString("C")</p>
                        </div>
                        <p class="font-medium">@((line.UnitPrice * line.Quantity).ToString("C"))</p>
                    </div>
                }
            </div>

            <div class="mt-4 flex flex-col items-end gap-1">
                <p>Subtotal: <span class="font-medium">@order.Subtotal.ToString("C")</span></p>
                <p>Shipping: <span class="font-medium">@order.ShippingCost.ToString("C")</span></p>
                <p class="text-lg font-bold">Total: @order.Total.ToString("C")</p>
            </div>
        </section>
    </div>
}
else if (Model.Attempt < GlimpsesOfGlory.Web.Pages.Checkout.ConfirmationModel.MaxPollAttempts)
{
    <meta http-equiv="refresh" content="2;url=/checkout/confirmation?payment_intent=@Model.PaymentIntentId&attempt=@(Model.Attempt + 1)" />
    <div class="py-4 max-w-xl mx-auto text-center">
        <h1 class="text-2xl font-bold mb-2">Confirming your payment&hellip;</h1>
        <p class="text-gray-600">This usually takes just a moment. Please don't close this page.</p>
    </div>
}
else
{
    <div class="py-4 max-w-xl mx-auto text-center">
        <h1 class="text-2xl font-bold mb-2">Payment received</h1>
        <p class="text-gray-600">We're still finalizing your order. You'll receive a confirmation email shortly.</p>
    </div>
}
