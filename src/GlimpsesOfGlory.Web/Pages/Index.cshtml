@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
    ViewData["MetaDescription"] = "Nature photography and inspirational calendars by Amy Aksionova. Shop the 2026 'Rejoice, My Soul' calendar, with proceeds supporting ministry in Ukraine.";
    ViewData["OgImage"] = $"{HttpContext.Request.Scheme}://{HttpContext.Request.Host}/images/header-photo.jpg";
}

<section class="full-bleed relative flex min-h-[420px] items-center justify-center overflow-hidden md:min-h-[560px]">
    <img src="/images/header-photo.jpg" alt="Sunlight breaking through storm clouds" class="absolute inset-0 h-full w-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-t from-ink/80 via-ink/40 to-ink/20"></div>
    <div class="relative px-4 text-center text-white">
        <p class="mb-3 text-xs font-semibold uppercase tracking-[0.3em] text-gold-light">Photography of God’s Beautiful Handiwork</p>
        <h1 class="font-display text-4xl font-bold drop-shadow-sm md:text-6xl">Glimpses of Glory</h1>
        <p class="mx-auto mt-4 max-w-xl text-base text-cream/90 md:text-lg">
            Focusing on God’s wonderful Word and His wonder-filled works
        </p>
        <a asp-page="/Products/Index" class="btn-primary mt-8 focus-visible:outline-white">
            Shop the Collection
        </a>
    </div>
</section>

@* Featured pieces sit straight under the hero so a phone reaches products within the first two screens. *@
<section class="container mx-auto px-4 py-10 md:py-24" data-testid="featured">
    <div class="mb-6 text-center md:mb-10">
        <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-gold-dark">Shop</p>
        <h2 class="text-3xl font-bold md:text-4xl">Featured pieces</h2>
    </div>

    @if (Model.FeaturedProducts.Count == 0)
    {
        <p class="text-center text-ink-light">New pieces are on their way &mdash; check back soon.</p>
    }
    else
    {
        <partial name="_ProductGrid" model="Model.FeaturedProducts" />

        <div class="mt-10 text-center">
            <a asp-page="/Products/Index" class="inline-block rounded-full border border-ink px-6 py-3 font-semibold transition-colors hover:bg-ink hover:text-white">
                View all products
            </a>
        </div>
    }
</section>

<section class="bg-cream-dark py-16 md:py-24">
    <div class="container mx-auto grid grid-cols-1 gap-10 px-4 md:grid-cols-3">
        <div>
            <h3 class="font-display mb-2 text-xl font-bold">Rejoice, My Soul</h3>
            <p class="text-sm leading-relaxed text-ink-light">
                This year&#39;s calendar title includes the “command” to rejoice! This imperative is found
                over 250 times in the Bible. God wants us to be filled with deep joy. He loves us. He
                gave us truth in His word. He saved us. He is a caring and attentive God.
                May these calendar images from God&#39;s wondrous creation and the truths from His Word
                remind you of reasons to rejoice!
            </p>
        </div>
        <div>
            <h3 class="font-display mb-2 text-xl font-bold">A Gift that Keeps on Giving …</h3>
            <p class="text-sm leading-relaxed text-ink-light">
                Each monthly calendar card outlasts the dates printed on it! When the month is done,
                cut off the bottom calendar portion (using the dotted indicators), and turn it into wall art
                or a note card to share.
            </p>
        </div>
        <div>
            <h3 class="font-display mb-2 text-xl font-bold">… and Giving</h3>
            <p class="text-sm leading-relaxed text-ink-light">
                A portion of the proceeds is sent to our personal friend Volodya. A full-time pastor in
                Ukraine, Volodya faithfully works with recovering addicts and pastors a small home-based church. He has been suffering from stress-induced, wartime medical issues.
            </p>
        </div>
    </div>
</section>

<section id="about" class="container mx-auto max-w-2xl px-4 py-16 text-center md:py-24">
    <img src="/images/amy-aksionova.jpg" alt="Portrait of Amy Aksionova" width="128" height="128" loading="lazy" decoding="async"
         class="mx-auto mb-6 h-28 w-28 rounded-full object-cover shadow-lg ring-4 ring-white md:h-32 md:w-32" />
    <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-gold-dark">About the artist</p>
    <h2 class="mb-4 text-3xl font-bold md:text-4xl">Amy Aksionova</h2>
    <p class="mb-4 leading-relaxed text-ink-light">
        As a teenager, I started nature photography in order to capture beautiful sunsets and unusual clouds near my home in Minnesota. God’s everyday wonders are often “hidden in plain view.” I enjoy noticing them and capturing their beauty with my camera.
        Much love and gratitude to my husband, who gives moral and technical support, and who gave me some of the beautiful flowers displayed in my work.
    </p>
</section>
