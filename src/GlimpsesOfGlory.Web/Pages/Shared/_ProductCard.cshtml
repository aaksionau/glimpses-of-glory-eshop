@model GlimpsesOfGlory.Abstractions.Dtos.ProductSummary

<a href="/products/@Model.Slug" class="group relative block overflow-hidden rounded-2xl border border-ink/5 bg-white shadow-sm transition-shadow hover:shadow-lg">
    @if (Model.IsPreorder)
    {
        <partial name="/Pages/Products/_PreorderBadge.cshtml" model="@("absolute top-3 right-3 z-10")" />
    }
    else if (Model.StockQuantity <= 0)
    {
        <partial name="/Pages/Products/_OutOfStockBadge.cshtml" model="@("absolute top-3 right-3 z-10")" />
    }
    <div class="aspect-[3/4] overflow-hidden bg-cream-dark">
        @if (Model.ThumbnailFileName is not null)
        {
            @* The 3:4 box and the intrinsic width/height reserve the space before the photo arrives, so the grid
               doesn't jump; lazy loading leaves photos further down the page until they're scrolled near. *@
            <img src="/product-photos/@Model.ThumbnailFileName" alt="@Model.Name"
                 width="600" height="800" loading="@(ViewData["EagerImage"] is true ? null : "lazy")" decoding="async"
                 class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105 @(!Model.IsPreorder && Model.StockQuantity <= 0 ? "opacity-50" : "")" />
        }
        else
        {
            <div class="flex h-full w-full items-center justify-center text-ink-light text-sm">No photo</div>
        }
    </div>
    <div class="p-4">
        <h3 class="font-semibold text-ink">@Model.Name</h3>
        <p class="mt-1 font-medium text-gold-dark">@Model.Price.ToString("C")</p>
    </div>
</a>
