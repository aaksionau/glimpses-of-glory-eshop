@model GlimpsesOfGlory.Abstractions.Dtos.AdminOrderDetail
@using GlimpsesOfGlory.Abstractions.Enums
@using GlimpsesOfGlory.Web.Helpers

@* What goes in the box and where it goes. Deliberately leaves out admin-only details
   (internal note, payment, prices) - the slip travels with the parcel. *@
<article id="packing-slip" class="max-w-3xl rounded-lg border border-black/10 bg-white p-6 text-sm print:max-w-none print:rounded-none print:border-0 print:p-0">
    <header class="flex flex-wrap items-start justify-between gap-4 border-b border-black/20 pb-4">
        <div>
            <p class="font-display text-2xl font-bold">Glimpses of Glory</p>
            <p class="text-gray-600">Packing slip</p>
        </div>
        <dl class="grid grid-cols-[auto_auto] gap-x-3 text-right">
            <dt class="text-gray-600">Order</dt>
            <dd class="font-semibold">#@Model.Id</dd>
            <dt class="text-gray-600">Date</dt>
            <dd>@Model.CreatedAt.ToString("MMMM d, yyyy")</dd>
        </dl>
    </header>

    <section class="mt-4" aria-labelledby="packing-slip-recipient-heading">
        @if (Model.FulfillmentMethod == FulfillmentMethod.Pickup)
        {
            <h2 id="packing-slip-recipient-heading" class="font-semibold">Local pickup for</h2>
            <p>@Model.Address.FullName</p>
        }
        else
        {
            <h2 id="packing-slip-recipient-heading" class="font-semibold">Ship to</h2>
            <p>
                @Model.Address.FullName<br />
                @Model.Address.AddressLine1<br />
                @if (!string.IsNullOrWhiteSpace(Model.Address.AddressLine2))
                {
                    @Model.Address.AddressLine2<text><br /></text>
                }
                @Model.Address.City, @Model.Address.State @Model.Address.PostalCode<br />
                @Model.Address.Country
            </p>
        }
    </section>

    <table class="mt-6 w-full border-collapse text-left">
        <thead>
            <tr class="border-b border-black/20 text-gray-600">
                <th scope="col" class="py-2 pr-2">Item</th>
                <th scope="col" class="w-16 py-2 text-right">Qty</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var line in Model.Lines)
            {
                <tr class="break-inside-avoid border-b border-black/10 align-top">
                    <td class="py-2 pr-2">
                        @line.ProductName
                        @if (PreorderNoteFormatter.Format(line.IsPreorder, line.ExpectedAvailabilityDate) is { } preorderNote)
                        {
                            <p class="text-gray-600">@preorderNote</p>
                        }
                    </td>
                    <td class="py-2 text-right">@line.Quantity</td>
                </tr>
            }
        </tbody>
    </table>

    <p class="mt-6 text-gray-600">Thank you for your order!</p>
</article>
