@model GlimpsesOfGlory.Web.Pages.Admin.Shipping.IndexModel

<div id="shipping-form" class="max-w-md">
    @if (!string.IsNullOrEmpty(Model.SavedMessage))
    {
        <p class="text-green-700 mb-4">@Model.SavedMessage</p>
    }

    <form hx-post="/admin/shipping" hx-target="#shipping-form" hx-swap="outerHTML" asp-antiforgery="true" class="flex flex-col gap-4">
        <div asp-validation-summary="ModelOnly" class="text-red-600"></div>

        @for (var i = 0; i < Model.Tiers.Count; i++)
        {
            <fieldset class="border border-black/10 rounded p-4">
                <legend class="px-1 text-sm font-medium">Tier @(i + 1)</legend>
                <input type="hidden" asp-for="Tiers[i].Id" />

                <label class="block mb-2">
                    <span class="block mb-1 text-sm">Minimum quantity</span>
                    <input asp-for="Tiers[i].MinQuantity" type="number" min="0" required class="w-full border border-black/20 rounded px-3 py-2" />
                    <span asp-validation-for="Tiers[i].MinQuantity" class="text-red-600 text-sm"></span>
                </label>

                <label class="block">
                    <span class="block mb-1 text-sm">Amount</span>
                    <input asp-for="Tiers[i].Amount" type="number" step="0.01" min="0" required class="w-full border border-black/20 rounded px-3 py-2" />
                    <span asp-validation-for="Tiers[i].Amount" class="text-red-600 text-sm"></span>
                </label>
            </fieldset>
        }

        <button type="submit" class="bg-black text-white px-6 py-3 rounded-lg font-semibold mt-2">Save shipping rates</button>
    </form>
</div>
