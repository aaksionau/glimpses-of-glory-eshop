@model GlimpsesOfGlory.Web.Pages.Admin.Products.EditModel

<div id="product-form">
    <div class="flex justify-between items-center mb-4">
        <h2 class="text-xl font-semibold">Edit product</h2>
        <form hx-post="/admin/products/@Model.Id/edit?handler=ToggleActive" hx-target="#product-form" hx-swap="outerHTML" asp-antiforgery="true">
            <button type="submit" class="border border-black px-3 py-1 text-sm">
                @(Model.IsActive ? "Hide from storefront" : "Unhide")
            </button>
        </form>
    </div>

    @if (!string.IsNullOrEmpty(Model.SavedMessage))
    {
        <p class="text-green-700 mb-4">@Model.SavedMessage</p>
    }

    <form hx-post="/admin/products/@Model.Id/edit" hx-target="#product-form" hx-swap="outerHTML" asp-antiforgery="true" class="flex flex-col gap-4 mb-8">
        <div asp-validation-summary="ModelOnly" class="text-red-600"></div>

        <partial name="_ProductFields" for="Input" />

        <button type="submit" class="bg-black text-white px-6 py-3 rounded-lg font-semibold mt-2">Save changes</button>
    </form>
</div>
