@page
@model GlimpsesOfGlory.Web.Pages.Products.IndexModel
@{
    ViewData["Title"] = "Products";
    ViewData["MetaDescription"] = "Browse all products currently available at Glimpses of Glory.";
}

<div class="py-4">
    <h1 class="text-3xl font-bold mb-6">Products</h1>

    @if (Model.Products.Count == 0)
    {
        <p>No products available right now.</p>
    }
    else
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var product in Model.Products)
            {
                <a href="/products/@product.Slug" class="relative block border border-black/10 rounded-lg overflow-hidden hover:shadow-lg transition-shadow">
                    @if (product.StockQuantity <= 0)
                    {
                        <partial name="_OutOfStockBadge" model="@("absolute top-2 right-2 z-10")" />
                    }
                    @if (product.ThumbnailFileName is not null)
                    {
                        <img src="/product-photos/@product.ThumbnailFileName" alt="@product.Name" class="w-full h-48 object-cover @(product.StockQuantity <= 0 ? "opacity-50" : "")" />
                    }
                    else
                    {
                        <div class="w-full h-48 bg-gray-200 flex items-center justify-center text-gray-500">No photo</div>
                    }
                    <div class="p-4">
                        <h2 class="font-semibold text-lg">@product.Name</h2>
                        <p class="text-gray-700">@product.Price.ToString("C")</p>
                    </div>
                </a>
            }
        </div>
    }
</div>
