@model GlimpsesOfGlory.Abstractions.Orders.OrderShippedView
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Order Shipped</title>
</head>
<body style="font-family: sans-serif; color: #1f2937;">
    <h1>Your order is on its way, @Model.Address.FullName!</h1>
    <p>Order #@Model.OrderId has shipped.</p>

    @if (!string.IsNullOrWhiteSpace(Model.TrackingNumber))
    {
        <p>Tracking number: <strong>@Model.TrackingNumber</strong></p>
    }

    <table style="width: 100%; border-collapse: collapse;">
        <thead>
            <tr>
                <th style="text-align: left; border-bottom: 1px solid #d1d5db;">Item</th>
                <th style="text-align: right; border-bottom: 1px solid #d1d5db;">Qty</th>
                <th style="text-align: right; border-bottom: 1px solid #d1d5db;">Price</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var line in Model.Lines)
            {
                <tr>
                    <td>@line.ProductName</td>
                    <td style="text-align: right;">@line.Quantity</td>
                    <td style="text-align: right;">@line.UnitPrice.ToString("C")</td>
                </tr>
            }
        </tbody>
    </table>

    <p style="text-align: right; margin-top: 1rem;">
        <strong>Total: @Model.Total.ToString("C")</strong>
    </p>

    <h2>Shipping to</h2>
    <p>
        @Model.Address.FullName<br />
        @Model.Address.AddressLine1<br />
        @if (!string.IsNullOrWhiteSpace(Model.Address.AddressLine2))
        {
            @Model.Address.AddressLine2<text><br /></text>
        }
        @Model.Address.City, @Model.Address.State @Model.Address.PostalCode<br />
        @Model.Address.Country
    </p>
</body>
</html>
