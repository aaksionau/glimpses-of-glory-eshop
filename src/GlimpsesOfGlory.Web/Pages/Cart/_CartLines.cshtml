@model GlimpsesOfGlory.Web.Dtos.CartLinesView
@using GlimpsesOfGlory.Abstractions.Dtos
@using GlimpsesOfGlory.Abstractions.Constants
@using GlimpsesOfGlory.Abstractions.Enums
@using GlimpsesOfGlory.Web.Dtos
@{
    // A partial never takes a layout; this also keeps it renderable on its own (in tests).
    Layout = null;
    var cart = Model.Cart;
}

<div id="cart-lines">
    @if (Model.Message is not null)
    {
        <p class="text-red-600 mb-4" role="alert">@Model.Message</p>
    }

    @if (Model.RemovedLine is { } removed)
    {
        @* Undo puts the line back with the quantity it had; the button is disabled while that posts
           so a double click can't add it twice. It takes focus (htmx honours autofocus on swap): the
           Remove button that had it is gone, and landing on Undo also reads the notice out. *@
        <div class="flex flex-wrap items-center gap-2 mb-4 rounded-lg bg-cream-dark px-4 py-2" role="status" data-removed-line="@removed.ProductSlug">
            <span>Removed @removed.ProductName</span>
            <span aria-hidden="true">&middot;</span>
            <form hx-post="/cart?handler=UndoRemove" hx-target="#cart-lines" hx-swap="outerHTML" hx-sync="closest #cart-lines:drop" hx-disabled-elt="find button" asp-antiforgery="true">
                <input type="hidden" name="slug" value="@removed.ProductSlug" />
                <input type="hidden" name="quantity" value="@removed.Quantity" />
                <button type="submit" autofocus aria-label="Undo removing @removed.ProductName" class="font-semibold text-gold-dark hover:underline px-1 py-2 disabled:opacity-50">Undo</button>
            </form>
        </div>
    }

    @if (cart.Lines.Count == 0)
    {
        <div class="flex flex-col items-center gap-3 rounded-lg bg-cream-dark px-6 py-12 text-center" data-testid="cart-empty">
            <p class="text-xl font-semibold font-display">Your cart is empty.</p>
            <p class="text-ink-light">Find a print or a card you love and it will wait for you here.</p>
            <a href="/products" class="btn-primary mt-2">Browse products</a>
        </div>
    }
    else
    {
        <div class="flex flex-col gap-4">
            @foreach (var line in cart.Lines)
            {
                var lineError = Model.ErrorFor(line.ProductSlug);
                var hasError = lineError is not null;
                var productUrl = $"/products/{line.ProductSlug}";
                var stepper = new QuantityStepperView(line.ProductSlug, line.ProductName, line.Quantity,
                    line.IsPreorder ? PreorderPolicy.MaxQuantityPerLine : null, hasError ? $"error-{line.ProductSlug}" : null);
                @* A fixed grid so a line never wraps by the length of its name. On mobile it is two rows
                   (image | name, price | Remove, then stepper … line total); from sm: it is one row. *@
                <div class="@(hasError ? "border-l-4 border-l-red-600 pl-3 " : "")grid grid-cols-[4rem_minmax(0,1fr)_auto] items-center gap-x-4 gap-y-3 border-b border-ink/10 pb-4 sm:grid-cols-[4rem_minmax(0,1fr)_auto_6rem_auto]" data-line-error="@(hasError ? "true" : null)" data-cart-line="@line.ProductSlug">
                    @* The name links too; the image link is skipped by keyboard and screen readers so the
                       product isn't announced twice. *@
                    <a href="@productUrl" tabindex="-1" aria-hidden="true" class="col-start-1 row-start-1">
                        @if (line.ThumbnailFileName is not null)
                        {
                            <img src="/product-photos/@line.ThumbnailFileName" alt="" class="w-16 h-16 object-cover rounded-lg" />
                        }
                        else
                        {
                            <div class="w-16 h-16 bg-cream-dark rounded-lg flex items-center justify-center text-ink-light text-xs">No photo</div>
                        }
                    </a>

                    <div class="col-start-2 row-start-1 min-w-0">
                        <a href="@productUrl" class="font-semibold break-words hover:underline">@line.ProductName</a>
                        <p class="text-ink-light text-sm">@line.UnitPrice.ToString("C") each</p>
                        @if (PreorderNoteFormatter.Format(line.IsPreorder, line.ExpectedAvailabilityDate) is { } note)
                        {
                            <p class="text-gold-dark text-sm font-medium">@note</p>
                        }
                    </div>

                    @* The short delay lets a few quick taps go as one save, and the spinner shows while the line
                       saves. Every cart form syncs on #cart-lines and drops a post while another is in flight: the
                       session cart is last-write-wins, so two overlapping saves could lose one, and the later swap
                       could show a stale cart. *@
                    <form class="col-span-2 col-start-1 row-start-2 flex items-center gap-1 sm:col-span-1 sm:col-start-3 sm:row-start-1"
                          hx-post="/cart?handler=UpdateQuantity" hx-target="#cart-lines" hx-swap="outerHTML" hx-trigger="change delay:400ms"
                          hx-sync="closest #cart-lines:drop"
                          hx-indicator="#saving-@line.ProductSlug" asp-antiforgery="true">
                        <input type="hidden" name="slug" value="@line.ProductSlug" />
                        <partial name="_QuantityStepper" model="stepper" />
                        <svg id="saving-@line.ProductSlug" class="htmx-indicator h-5 w-5 animate-spin text-gold-dark" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 0 1 8-8v4a4 4 0 0 0-4 4H4z"></path>
                        </svg>
                    </form>

                    <p class="col-start-3 row-start-2 text-right font-medium sm:col-start-4 sm:row-start-1" data-testid="line-total">@((line.UnitPrice * line.Quantity).ToString("C"))</p>

                    @* Undo makes removing low-stakes, so Remove stays quiet beside the checkout CTA. *@
                    <form class="col-start-3 row-start-1 justify-self-end sm:col-start-5" hx-post="/cart?handler=Remove" hx-target="#cart-lines" hx-swap="outerHTML" hx-sync="closest #cart-lines:drop" asp-antiforgery="true">
                        <input type="hidden" name="slug" value="@line.ProductSlug" />
                        <button type="submit" aria-label="Remove @line.ProductName" class="text-ink-light hover:text-ink hover:underline px-2 py-3">Remove</button>
                    </form>

                    @if (lineError is not null)
                    {
                        <p class="col-span-full text-red-600 text-sm" id="error-@line.ProductSlug">@lineError.Message</p>
                    }
                </div>
            }
        </div>

        @* A fixed width from sm: keeps the label/value rows aligned in one right-hand column. *@
        <div class="mt-6 flex flex-col gap-1 sm:ml-auto sm:w-96" data-testid="cart-totals">
            <p class="flex justify-between gap-4">Subtotal <span>@cart.Subtotal.ToString("C")</span></p>
            <p class="flex justify-between gap-4 text-ink-light text-sm" data-testid="cart-shipping">Shipping <span>@cart.ShippingCost.ToString("C") &middot; or free local pickup</span></p>
            <p class="flex justify-between gap-4 text-lg font-bold" data-testid="cart-estimated-total">Estimated total <span>@cart.TotalFor(FulfillmentMethod.Shipping).ToString("C")</span></p>
            <a href="/checkout" class="btn-primary mt-2 sm:self-end w-full sm:w-auto">Proceed to checkout</a>
        </div>
    }
</div>
