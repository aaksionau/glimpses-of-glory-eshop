@model GlimpsesOfGlory.Web.Pages.Admin.Orders.DetailsModel
@using GlimpsesOfGlory.Abstractions.Enums

@* Rendered in the page header; re-sent out-of-band after each htmx action so it stays in sync. *@
<div id="order-header-badges" class="flex flex-wrap items-center gap-2" hx-swap-oob="@Model.OutOfBandSwap">
    <partial name="_Badge" model="OrderBadges.Status(Model.Order.Status)" />
    <partial name="_Badge" model="OrderBadges.Payment(Model.Order.IsPaid)" />
    @if (Model.Order.FulfillmentMethod == FulfillmentMethod.Pickup)
    {
        <partial name="_Badge" model="OrderBadges.Pickup" />
    }
    @if (Model.Order.Actions.NeedsRefund)
    {
        <partial name="_Badge" model="OrderBadges.RefundRequired" />
    }
</div>
