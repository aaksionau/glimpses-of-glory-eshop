<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Doubles shared with the unit tests rather than copied. Each test builds its own instances,
       so mutable ones (FakePaymentGateway.NextWebhookResult) are never shared between tests. -->
  <ItemGroup>
    <Compile Include="../GlimpsesOfGlory.UnitTests/FakePaymentGateway.cs" Link="Shared/FakePaymentGateway.cs" />
    <Compile Include="../GlimpsesOfGlory.UnitTests/FixedTimeProvider.cs" Link="Shared/FixedTimeProvider.cs" />
    <Compile Include="../GlimpsesOfGlory.UnitTests/NullEmailSender.cs" Link="Shared/NullEmailSender.cs" />
    <!-- Not thread-safe, but in the race tests only the winning transition sends an email. -->
    <Compile Include="../GlimpsesOfGlory.UnitTests/RecordingEmailSender.cs" Link="Shared/RecordingEmailSender.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GlimpsesOfGlory.Core\GlimpsesOfGlory.Core.csproj" />
    <ProjectReference Include="..\..\src\GlimpsesOfGlory.Web\GlimpsesOfGlory.Web.csproj" />
  </ItemGroup>

</Project>
