@model GlimpsesOfGlory.Abstractions.Dtos.ShippingAddressInfo

@* The postal address block, shared by the admin fulfillment card, the packing slip and the order confirmation so they always match. *@
<p>
    @Model.FullName<br />
    @Model.AddressLine1<br />
    @if (!string.IsNullOrWhiteSpace(Model.AddressLine2))
    {
        @Model.AddressLine2<text><br /></text>
    }
    @Model.City, @Model.State @Model.PostalCode<br />
    @Model.Country
</p>
